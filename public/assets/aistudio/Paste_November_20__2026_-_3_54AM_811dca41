        return emps.filter((e) => planFor(e, selDay) === code);
      };
      const plannedOf = (code) => emps.filter((e) => planFor(e, realDay) === code && att[e.id] !== 'WO').length;
      const codes = Object.keys(defs);
      const memAll = {}; codes.forEach((c) => { memAll[c] = membersOf(c); });      // everyone assigned to the line (incl. on break) - used for shortage maths
      const memMap = {}; codes.forEach((c) => { memMap[c] = isToday ? memAll[c].filter((e) => !(asg[e.id] || {}).onBreak) : memAll[c]; });   // shown in the line box: on-break people move to the Break box
      const onBreakList = isToday ? emps.filter((e) => att[e.id] === 'Present' && asg[e.id] && asg[e.id].onBreak) : [];

      const counts = { present: 0, absent: 0, eo: 0, wo: 0 };
      emps.forEach((e) => { const s = att[e.id]; if (s === 'Present') counts.present++; else if (s === 'AB' || s === 'LV') counts.absent++; else if (s === 'EO') counts.eo++; else if (s === 'WO') counts.wo++; });
      const breaksDone = emps.filter((e) => asg[e.id] && asg[e.id].breakStatus === 'completed').length;
      const breaksPending = emps.filter((e) => att[e.id] === 'Present' && asg[e.id] && asg[e.id].breakStatus === 'pending').length;
      const breakingNow = onBreakList.length;

      const breachMap = {}; (S.minStaffBreaches || []).forEach((b) => { breachMap[b.code] = b; });
      // per-line staffing: have = people on the line now, planned = people the weekly plan expects (week-offs excluded)
      const stat = {};
      codes.forEach((c) => {
        const have = memAll[c].length, planned = plannedOf(c);
        const active = memMap[c].length;
        let kind = 'none';
        if (isToday && !disabled[c] && (planned > 0 || have > 0)) kind = have < planned ? 'short' : have > planned ? 'extra' : 'ok';
        stat[c] = { have: have, planned: planned, active: active, kind: kind, deficit: Math.max(0, planned - have) };
      });
      const shortages = [];
      (S.minStaffBreaches || []).forEach((b) => shortages.push({ code: b.code, text: b.code + ' ' + b.active + '/' + b.min + ' (min)' }));
      if (isToday) codes.forEach((c) => {
        if (disabled[c] || breachMap[c]) return;
        if (stat[c].kind === 'short') shortages.push({ code: c, text: c + ' (' + stat[c].deficit + ')' });
        else if (stat[c].planned > 0 && stat[c].active === 0) shortages.push({ code: c, text: c + ' 0 active' });
      });
      // low-staff forecast: line is fine now, but one more person going on break drops it under its minimum
      const forecastWarn = [];
      if (isToday) codes.forEach((c) => {
        if (disabled[c]) return;
        const mn = (S.minStaff || {})[c] || 0;
        const pend = memMap[c].filter((e) => (asg[e.id] || {}).breakStatus === 'pending' && !(asg[e.id] || {}).onBreak).length;
        if (mn > 0 && pend > 0 && stat[c].active >= mn && stat[c].active - 1 < mn) forecastWarn.push({ code: c, after: stat[c].active - 1, min: mn });
      });
      const fcMap = {}; forecastWarn.forEach((f) => { fcMap[f.code] = f; });
      const ovCodes = codes.slice().sort((x, y) => { const ix = OVERVIEW_ORDER.indexOf(x), iy = OVERVIEW_ORDER.indexOf(y); return (ix < 0 ? 99 : ix) - (iy < 0 ? 99 : iy) || x.localeCompare(y); });
      const nsReqAll = S.nonSortRequests || [];
      const nsPending = nsReqAll.filter((r) => r.status === 'pending').length;

      // board order
      const hasPeople = codes.filter((c) => memAll[c].length > 0 && PRIORITY.indexOf(c) < 0);
      const sortRest = (a, b) => { const ia = AFTER_ORDER.indexOf(a), ib = AFTER_ORDER.indexOf(b); return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b); };
      const midLines = hasPeople.slice().sort(sortRest);
      const emptyLines = codes.filter((c) => memAll[c].length === 0 && PRIORITY.indexOf(c) < 0).sort(sortRest);
      const priorityLines = PRIORITY.filter((c) => defs[c]);
      const boardCols = [].concat(priorityLines.map((c) => ({ t: 'line', code: c })), [{ t: 'break' }], midLines.map((c) => ({ t: 'line', code: c })), emptyLines.map((c) => ({ t: 'line', code: c })));
      const visibleCols = inspect ? boardCols.filter((c) => c.t === 'break' || c.code === inspect) : boardCols;

      // click a task card at the top: smoothly scroll to its box and flash it (no abrupt re-layout)
      const goBox = (c) => {
        const run2 = () => { const el = document.getElementById('box-' + c); if (!el) return; el.scrollIntoView({ behavior: 'smooth', block: 'center' }); setFlash(c); setTimeout(() => setFlash(''), 1700); };
        if (inspect && inspect !== c) { setInspect(''); setTimeout(run2, 80); } else run2();
      };

      const eStatusBadge = (e) => {
        const d = (S.attendanceDetail || {})[e.id] || {};
        return (
          <>
            {d.late && <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200">Late {d.late.mins}m ({d.late.time})</span>}
            {d.left && <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-rose-100 text-rose-800 border border-rose-200">Left {d.left.time}</span>}
          </>
        );
      };

      // ----- cards -----
      const CCCard = ({ e }) => {
        const a = asg[e.id] || {};
        const planned = planFor(e, realDay);
        const isHelper = !!a.isHelping, covering = !!a.swappedFrom;
        const summoned = (S.activeSummons || []).some((s) => lc(s.targetId) === lc(e.id));
        return (
          <div key={e.id} draggable={!!(canAct && isToday)} onDragStart={(ev) => { const ids = sel[e.id] ? Object.keys(sel).filter((k) => sel[k]) : [e.id]; try { ev.dataTransfer.setData('text/plain', JSON.stringify(ids)); ev.dataTransfer.effectAllowed = 'move'; } catch (x) {} }}
            className={'bg-white border rounded-xl px-2.5 pt-2.5 pb-2 shadow-sm ' + (summoned ? 'border-amber-400' : 'border-slate-200') + (sel[e.id] ? ' ring-2 ring-sky-500' : '') + (canAct && isToday ? ' cursor-grab' : '')}>
            <div className="flex items-start justify-between gap-2">
              <div className="min-w-0">
                <div className="text-[13px] font-bold text-slate-800 truncate">{moveMode && canAct && <input type="checkbox" checked={!!sel[e.id]} onChange={() => setSel((p) => Object.assign({}, p, { [e.id]: !p[e.id] }))} className="mr-1.5 align-middle" />}{e.name}</div>
                <div className="text-[10px] text-slate-400 font-mono truncate">{e.id}</div>
              </div>
              {isHelper ? <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded-md bg-amber-100 text-amber-800 border border-amber-200 whitespace-nowrap">Helper &middot; base {a.originalStation}</span>
                : covering ? <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded-md bg-indigo-100 text-indigo-800 border border-indigo-200">Covering</span>
                : <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200">Primary</span>}
            </div>
            {(((S.attendanceDetail || {})[e.id] || {}).late || ((S.attendanceDetail || {})[e.id] || {}).left || a.breakStatus === 'completed' || summoned) && (
              <div className="flex flex-wrap gap-1 mt-1.5">{eStatusBadge(e)}{a.breakStatus === 'completed' && <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">Break done</span>}{summoned && <span className="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">Called</span>}</div>
            )}
            <div className="flex items-center flex-wrap gap-x-2 gap-y-1 mt-2 pt-2 border-t border-slate-100">
              <span className="text-[10px] font-semibold text-sky-700">Plan: {planned}</span>
              {canAct && (
                <>
                  {a.breakStatus === 'pending' && <LinkBtn tone="text-amber-700" disabled={busy} onClick={() => run('breakStart', { empId: e.id }, 'Break started: ' + e.name)}>&#9749; Break</LinkBtn>}
                  {a.breakStatus === 'completed' && <LinkBtn tone="text-slate-500" disabled={busy} onClick={() => run('breakUndo', { empId: e.id }, 'Break reset')}>&#8617; Undo break</LinkBtn>}
                  {isHelper ? <LinkBtn tone="text-sky-700" disabled={busy} onClick={() => run('helperRevert', { empId: e.id }, (r) => 'Helper ended (' + r.durationFormatted + ')')}>Revert helper</LinkBtn>
                    : <LinkBtn tone="text-sky-700" disabled={busy} onClick={() => setModal({ type: 'line', mode: 'helper', emp: e })}>Deploy Helper</LinkBtn>}
                  <LinkBtn tone="text-amber-700" disabled={busy} onClick={() => setModal({ type: 'call', emp: e })}>&#128276; Call</LinkBtn>
                  <LinkBtn tone="text-slate-500" disabled={busy} onClick={() => setModal({ type: 'line', mode: 'swap', emp: e })}>Swap</LinkBtn>
                </>
              )}
            </div>
          </div>
        );
      };

      const BreakCol = () => (
        <div className={'h-full w-full bg-amber-50 border-2 border-amber-300 rounded-2xl shadow-sm flex flex-col ' + (flash === 'BRK' ? 'box-flash' : '')}>
          <div className="shrink-0 px-3 py-2.5 border-b border-amber-200 flex items-start justify-between gap-2">
            <div>
              <div className="flex items-center gap-2"><span className="text-[10px] font-black text-white px-1.5 py-0.5 rounded bg-amber-800">&#9749; BRK</span><span className="text-xs font-bold text-slate-800">On Break (Live)</span></div>
              <div className="text-[10px] text-slate-600 mt-1">Current: <b>{onBreakList.length} CC</b></div>
            </div>
            <span className="text-[10px] font-bold border rounded-md px-2 py-0.5 bg-amber-100 text-amber-800 border-amber-300 whitespace-nowrap">{onBreakList.length} on Break</span>
          </div>
          <div className="p-2.5 space-y-2 flex-1 min-h-0 overflow-y-auto box-scroll">
            {onBreakList.length === 0 && <div className="border-2 border-dashed border-amber-300 rounded-xl text-center text-[11px] text-amber-800/80 py-9 px-3">&#9749; No colleagues on break.<br />All active staff on duty.</div>}
            {onBreakList.map((e) => {
              const a = asg[e.id]; const diff = a.breakEndTime - now; const over = diff < 0;
              return (
                <div key={e.id} className={'bg-white border rounded-xl p-2.5 ' + (over ? 'border-rose-400 pulse-red' : 'border-amber-200')}>
                  <div className="flex justify-between items-start"><div className="text-xs font-bold truncate">{e.name}</div><span className="text-[10px] text-slate-400">{curStation(a, '')}</span></div>
                  <div className={'text-lg font-mono font-bold ' + (over ? 'text-rose-600' : 'text-amber-700')}>{over ? '+' : ''}{fmtMMSS(Math.abs(diff))}</div>
                  <div className="text-[10px] text-slate-500">{over ? 'Overstay' : 'Remaining'} &middot; {a.breakDurationMins} min break</div>
                  {canAct && <div className="flex gap-1 mt-1.5"><Btn small tone="green" disabled={busy} onClick={() => run('breakEnd', { empId: e.id }, (r) => r.overtimeMins > 0 ? 'Returned (+' + r.overtimeMins + 'm overstay)' : 'Returned on time')}>Return</Btn><Btn small disabled={busy} onClick={() => run('breakUndo', { empId: e.id }, 'Break cancelled')}>Undo</Btn></div>}
                </div>
              );
            })}
          </div>
          <div className="shrink-0 px-3 py-2 border-t border-amber-200 text-center text-[10px] font-semibold text-slate-600">Standard Break Duration: {S.breakDurationSetting} mins</div>
        </div>
      );

      const LineCol = ({ code }) => {
        const d = defs[code] || {}; const list = memMap[code].filter(matches);
        const dis = !!disabled[code]; const st = stat[code]; const br = !!breachMap[code];
        const pill = st.kind === 'short' ? ['bg-rose-100 text-rose-700 border-rose-200', st.active + '/' + st.planned + ' Short']
          : st.kind === 'extra' ? ['bg-sky-100 text-sky-700 border-sky-200', st.active + '/' + st.planned + ' Extra']
          : st.kind === 'ok' ? ['bg-emerald-100 text-emerald-700 border-emerald-200', st.active + '/' + st.planned + ' OK'] : null;
        return (
          <div className={'h-full w-full border-2 rounded-2xl shadow-sm flex flex-col transition-colors duration-300 ' + ((st.kind === 'short' || br) ? 'border-rose-300 bg-rose-50/50 ' : 'border-slate-200 bg-white ') + (dis ? 'opacity-60 ' : '') + (flash === code ? 'box-flash' : '')}>
            <div className="shrink-0 px-3 py-2.5 border-b border-slate-100 flex items-start justify-between gap-2">
              <div className="min-w-0">
                <div className="flex items-center gap-2">
                  <span className={'text-[10px] font-black text-white px-1.5 py-0.5 rounded ' + (d.headerBg || 'bg-slate-600')}>{code}</span>
                  <span className="text-xs font-bold text-slate-800 truncate">{d.name || code}{dis ? ' (off)' : ''}</span>
                  <button title="Focus this line" onClick={() => setInspect(inspect === code ? '' : code)} className="text-slate-400 hover:text-slate-700 text-xs">&#128065;</button>
                </div>
                <div className="text-[10px] text-slate-500 mt-1">{isToday ? 'Active' : 'Planned'}: <b>{memMap[code].length} CC</b>{isToday && st.have > st.active ? <span className="text-amber-700"> &middot; {st.have - st.active} on break</span> : null}</div>
              </div>
              {isToday && pill && <span className={'text-[10px] font-bold border rounded-md px-2 py-0.5 whitespace-nowrap ' + pill[0]}>{pill[1]}</span>}
            </div>
            <div className="p-2.5 space-y-2 flex-1 min-h-0 overflow-y-auto box-scroll">
              {list.length === 0 && <div className="text-[11px] text-slate-400 italic text-center py-3">{memMap[code].length ? 'No match' : (memAll[code].length ? 'Everyone is on break' : 'Empty')}</div>}
              {list.map((e) => isToday ? CCCard({ e }) : (
                <div key={e.id} className="bg-white border border-slate-200 rounded-xl p-2.5"><div className="text-xs font-bold">{e.name}</div><div className="text-[10px] text-slate-400">Planned for {selDay}</div></div>
              ))}
            </div>
          </div>
        );
      };

      // ----- header + alert stack -----
      const helps = S.activeHelpRequests || [], summons = S.activeSummons || [], anns = S.announcements || [], over = S.overstayBreaks || [];
      const recentHelp = (S.helpLog || []).filter((h) => h.type !== 'raised' && now - h.ts < 120000).slice(0, 3);
      const alertCount = recentHelp.length + (S.minStaffBreaches || []).length + anns.length + helps.length + summons.length + over.length + (nsPending > 0 ? 1 : 0);
      const shiftLabel = (S.shiftStartMs && S.shiftEndMs) ? fmt12(S.shiftStartMs) + ' - ' + fmt12(S.shiftEndMs) : '12:00 AM - 09:00 AM';
      const VIEW_TABS = [['board', '🗂 Workstation Columns'], ['roster', '📋 Roster Table'], ['audit', '🕘 Audit & Logs'], ['weekly', '📅 Weekly Record']];

      return (
        <div className="min-h-screen">
          <header className="bg-[#0b1530] text-white shadow-lg">
            <div className="max-w-[1700px] mx-auto px-4 pt-4 pb-3 flex flex-wrap items-start justify-between gap-3">
              <div className="flex items-center gap-3">
                <div className="w-11 h-11 rounded-xl bg-sky-700 flex items-center justify-center text-xl">&#9636;</div>
                <div>
                  <div className="flex items-center gap-2 flex-wrap">
                    <h1 className="text-lg font-extrabold tracking-tight leading-tight">{S.shiftName || 'Shift A'} Operations Dashboard</h1>
                    <span className={'inline-flex items-center gap-1.5 text-[10px] font-black tracking-wide px-2 py-1 rounded-md border ' + (S.isShiftActive ? 'border-emerald-400/60 text-emerald-300 bg-emerald-500/10' : 'border-amber-400/60 text-amber-300 bg-amber-500/10')}><span className={'w-1.5 h-1.5 rounded-full ' + (S.isShiftActive ? 'bg-emerald-400' : 'bg-amber-400')}></span>{S.isShiftActive ? 'SHIFT LIVE' : 'SHIFT CLOSED'}</span>
                  </div>
                  <div className="text-[11px] text-slate-300 mt-0.5">{S.shiftName || 'Shift A'} ({shiftLabel}) &bull; Warehouse Workstation Allocations</div>
                  {loadErr && <div className="text-[11px] text-amber-300">Connection issue: retrying...</div>}
                </div>
              </div>
              <div className="flex bg-[#14213f] border border-slate-600/60 rounded-xl p-1 gap-1 overflow-x-auto max-w-full">
                {VIEW_TABS.map(([k, l]) => (
                  <button key={k} onClick={() => setView(k)} className={'px-3 py-1.5 rounded-lg text-[11px] font-bold whitespace-nowrap ' + (view === k ? 'bg-sky-700 text-white shadow' : 'text-slate-300 hover:bg-slate-700/60')}>{l}</button>
                ))}
              </div>
            </div>
            <div className="max-w-[1700px] mx-auto px-4 pb-4 flex flex-wrap items-center gap-3">
              <button onClick={() => setModal({ type: 'broadcast' })} className="relative bg-[#14213f] border border-slate-500/60 hover:bg-slate-700/60 rounded-xl px-3.5 py-2 text-xs font-bold flex items-center gap-1.5"><span className="text-rose-400">&#128226;</span> Broadcast{(S.broadcasts || []).length > 0 && <span className="absolute -top-1.5 -right-1.5 bg-sky-500 text-white text-[9px] font-black rounded-full px-1.5 py-0.5">{(S.broadcasts || []).length}</span>}</button>
              <button onClick={() => setModal({ type: 'nonsort' })} className={'relative bg-[#14213f] border rounded-xl px-3.5 py-2 text-xs font-bold flex items-center gap-1.5 hover:bg-slate-700/60 ' + (nsPending > 0 ? 'border-rose-400 pulse-red' : 'border-slate-500/60')}>&#128230; Non Sort{nsPending > 0 && <span className="min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-white text-[10px] font-black flex items-center justify-center">{nsPending}</span>}</button>
              <button onClick={() => setModal({ type: 'helplog' })} className={'relative bg-[#14213f] border rounded-xl px-3.5 py-2 text-xs font-bold flex items-center gap-1.5 hover:bg-slate-700/60 transition-colors ' + (helps.length > 0 ? 'border-rose-400' : 'border-slate-500/60')}>&#127384; Help Log{helps.length > 0 && <span className="min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-white text-[10px] font-black flex items-center justify-center">{helps.length}</span>}</button>
              <button onClick={() => setModal({ type: 'report' })} className="bg-[#14213f] border border-slate-500/60 rounded-xl px-3.5 py-2 text-xs font-bold hover:bg-slate-700/60 transition-colors">&#128203; Report</button>
              <button onClick={() => { setProdNew(''); setModal({ type: 'prod' }); }} className="relative bg-[#14213f] border border-slate-500/60 rounded-xl px-3.5 py-2 text-xs font-bold hover:bg-slate-700/60 transition-colors">&#128200; Productivity{prodNew && <span className="absolute -top-1.5 -right-1.5 bg-rose-600 text-white text-[9px] font-black rounded-full px-1.5 py-0.5 animate-pulse">NEW</span>}</button>
              <button onClick={() => setModal({ type: 'late' })} className="bg-[#14213f] border border-slate-500/60 rounded-xl px-3.5 py-2 text-xs font-bold hover:bg-slate-700/60 transition-colors">&#9200; Late{lateList(S).length > 0 && <span className="ml-1.5 inline-flex min-w-[18px] h-[18px] px-1 rounded-full bg-amber-500 text-slate-950 text-[10px] font-black items-center justify-center">{lateList(S).length}</span>}</button>
              <button disabled={!canAct || !isToday} onClick={() => { setMoveMode(!moveMode); setSel({}); }} className={'border rounded-xl px-3.5 py-2 text-xs font-bold transition-colors disabled:opacity-40 ' + (moveMode ? 'bg-sky-700 border-sky-300' : 'bg-[#14213f] border-slate-500/60 hover:bg-slate-700/60')}>&#9745; Multi-move</button>
              <button onClick={() => setDark(!dark)} title="Dark mode" className={'border rounded-xl px-3 py-2 text-xs font-bold transition-colors ' + (dark ? 'bg-sky-700 border-sky-300' : 'bg-[#14213f] border-slate-500/60 hover:bg-slate-700/60')}>&#127769;</button>
              <button onClick={() => setTv(!tv)} title="TV mode: big text, dark, auto-scroll" className={'border rounded-xl px-3 py-2 text-xs font-bold transition-colors ' + (tv ? 'bg-sky-700 border-sky-300' : 'bg-[#14213f] border-slate-500/60 hover:bg-slate-700/60')}>&#128250; TV</button>
              <div className="flex items-center gap-1 bg-[#14213f] border border-slate-600/60 rounded-xl p-1">
                {DAYS.map((d) => (
                  <button key={d} onClick={() => setDay(d)} className={'relative px-3 py-1.5 rounded-lg text-[11px] font-bold ' + (d === selDay ? 'bg-sky-700 text-white ring-2 ring-white/80' : 'text-slate-300 hover:bg-slate-700/60')}>{d}{d === realDay && <span className="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400 border border-[#14213f]"></span>}</button>
                ))}
              </div>
            </div>
          </header>

          {!isToday && <div className="bg-amber-50 border-b border-amber-200 text-amber-800 text-xs text-center py-1.5">Previewing <b>{selDay}</b> plan. Read-only. <button className="underline font-semibold" onClick={() => setDay(realDay)}>Back to today</button></div>}

          {/* sticky alert stack */}
          {alertCount > 0 && (
            <div className="sticky top-0 z-40 bg-slate-100/95 backdrop-blur border-b border-slate-200">
              <div className="max-w-[1700px] mx-auto px-4 py-2 space-y-1.5 max-h-[40vh] overflow-y-auto">
                {(S.minStaffBreaches || []).length > 0 && <div className="bg-rose-600 text-white text-xs rounded-lg px-3 py-1.5 pulse-red"><b>Minimum staff breached:</b> {(S.minStaffBreaches || []).map((b) => b.code + ' (' + b.active + '/' + b.min + ')').join(', ')}</div>}
                {anns.map((a) => (
                  <div key={a.id} className="bg-indigo-50 border border-indigo-200 text-indigo-900 text-xs rounded-lg px-3 py-1.5 flex items-center justify-between gap-2">
                    <div className="min-w-0"><b>&#128226; {a.target === 'ALL' ? 'Everyone' : a.target}:</b> {a.message} <span className="text-indigo-500 font-semibold">&#10004; {a.ackedCount}/{a.total}</span></div>
                    <Btn small disabled={busy} onClick={() => run('announceEnd', { id: a.id }, 'Announcement ended')}>End</Btn>
                  </div>
                ))}
                {helps.map((h) => (
                  <div key={h.id} className={'text-xs rounded-lg px-3 py-1.5 flex items-center justify-between gap-2 ' + (h.escalated ? 'bg-rose-600 border-2 border-rose-900 text-white pulse-red' : 'bg-rose-50 border border-rose-300 text-rose-900')}>
                    <div className="min-w-0"><b>&#128680; Help call:</b> {h.empName} at {h.location} ({h.station}) &middot; {h.timeStr}{h.reason ? <span className={'ml-1 font-bold px-1.5 py-0.5 rounded ' + (h.escalated ? 'bg-white/25' : 'bg-rose-200 text-rose-900')}>&#9888; {h.reason}</span> : null}{h.escalated ? <b className="ml-1">&#9200; NOT ACCEPTED for {Math.floor((h.waitMs || 0) / 60000)} min - TL notified</b> : null} &middot; {h.helperName ? h.helperName + ' is coming' : h.status === 'accepted' ? '✔ accepted by ' + (h.acceptedByRole === 'Dashboard' ? 'Supervisor (Dashboard)' : h.acceptedBy + (h.acceptedByRole ? ' (' + h.acceptedByRole + ')' : '')) + (h.acceptedAtStr ? ' at ' + h.acceptedAtStr : '') : 'awaiting response'}{h.imageUrl ? <span className="ml-2"><PhotoThumb url={h.imageUrl} h="h-9" /></span> : null}</div>
                    <div className="flex gap-1 shrink-0">
                      <Btn small tone="blue" disabled={busy} onClick={() => setModal({ type: 'helpHelper', req: h })}>Send helper</Btn>
                      <Btn small tone="green" disabled={busy} onClick={() => callApi('resolveHelpRequest', [h.id], 'Help call cleared')}>Clear</Btn>
                    </div>
                  </div>
                ))}
                {recentHelp.map((h) => (
                  <div key={h.id} className="bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs rounded-lg px-3 py-1.5 flex items-center justify-between gap-2 rise-in">
                    <div className="min-w-0">{HELP_ICON[h.type]} <b>{helpEventText(h)}</b> <span className="text-emerald-600">&middot; {h.timeStr}</span></div>
                    <Btn small onClick={() => setModal({ type: 'helplog' })}>Log</Btn>
                  </div>
                ))}
                {summons.map((s) => (
                  <div key={s.id} className="bg-amber-50 border border-amber-300 text-amber-900 text-xs rounded-lg px-3 py-1.5 flex items-center justify-between gap-2">
                    <div className="min-w-0"><b>&#128276; Summoned:</b> {s.targetName} &middot; "{s.message}" &middot; awaiting acknowledgement</div>
                    <Btn small disabled={busy} onClick={() => run('ringCancel', { empId: s.targetId }, 'Call cancelled')}>Cancel</Btn>
                  </div>
                ))}
                {over.map((o) => (
                  <div key={o.empId} className="bg-rose-50 border border-rose-300 text-rose-900 text-xs rounded-lg px-3 py-1.5 flex items-center justify-between gap-2">
                    <div><b>Break overstay:</b> {o.name} ({o.station}) is {o.overtimeMins} min over a {o.scheduledMins} min break</div>
                    <div className="flex gap-1 shrink-0"><Btn small tone="amber" disabled={busy || !canAct} onClick={() => setModal({ type: 'call', emp: { id: o.empId, name: o.name }, preset: 'Break ended - return to line' })}>&#128276; Call</Btn><Btn small tone="green" disabled={busy || !canAct} onClick={() => run('breakEnd', { empId: o.empId }, 'Returned')}>Return</Btn></div>
                  </div>
                ))}
                {nsPending > 0 && (
                  <div className="bg-sky-50 border border-sky-200 text-sky-900 text-xs rounded-lg px-3 py-1.5 flex items-center justify-between gap-2">
                    <div><b>&#128230; Non Sort:</b> {nsPending} request{nsPending > 1 ? 's' : ''} waiting for a count</div>
                    <Btn small tone="blue" onClick={() => setModal({ type: 'nonsort' })}>Open Non Sort</Btn>
                  </div>
                )}
              </div>
            </div>
          )}

          {moveMode && (
            <div className="bg-sky-50 border-b border-sky-200 sticky top-0 z-30">
              <div className="max-w-[1700px] mx-auto px-4 py-2 flex flex-wrap items-center gap-2 text-xs">
                <b className="text-sky-900">Multi-move:</b>
                <span className="text-slate-600">tick CCs (or drag a card onto a line box), then pick the line.</span>
                <span className="font-black text-sky-800">{Object.keys(sel).filter((k) => sel[k]).length} selected</span>
                <select value={moveTarget} onChange={(e) => setMoveTarget(e.target.value)} className="border border-slate-300 rounded-lg px-2 py-1 text-xs bg-white">
                  <option value="">Move to...</option>
                  {Object.keys(defs).filter((c) => !disabled[c]).map((c) => <option key={c} value={c}>{c} - {(defs[c] || {}).name}</option>)}
                </select>
                <Btn small tone="blue" disabled={busy || !moveTarget || !Object.keys(sel).some((k) => sel[k])} onClick={() => run('swapMany', { empIds: Object.keys(sel).filter((k) => sel[k]), target: moveTarget }, (r) => 'Moved ' + r.moved + ' to ' + moveTarget + (r.skipped && r.skipped.length ? ' (skipped ' + r.skipped.length + ')' : ''))}>Move selected</Btn>
                <Btn small onClick={() => setSel({})}>Clear ticks</Btn>
              </div>
            </div>
          )}

          {/* KPI band + workstation overview */}
          <div className="bg-white border-b border-slate-200">
            <div className="max-w-[1700px] mx-auto px-4 py-2.5 flex flex-wrap items-center gap-2">
              <Chip>&#128197; Schedule: <b>{selDay.toUpperCase()}</b>{isToday ? <span className={'text-[9px] font-black tracking-wide px-1.5 py-0.5 rounded border ' + (S.isShiftActive ? 'bg-emerald-100 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-500 border-slate-200')}>{S.isShiftActive ? 'LIVE SHIFT' : 'CLOSED'}</span> : <span className="text-[9px] font-black tracking-wide px-1.5 py-0.5 rounded border bg-amber-100 text-amber-700 border-amber-200">PLAN</span>}</Chip>
              <Chip tone="emerald">&#128100; <b>{counts.present}</b> Present</Chip>
              <Chip tone="rose">&#128683; <b>{counts.absent}</b> Absent</Chip>
              {counts.eo > 0 && <Chip tone="amber">&#128682; <b>{counts.eo}</b> Early out</Chip>}
              {counts.wo > 0 && <Chip tone="slate"><b>{counts.wo}</b> Week off</Chip>}
              <Chip tone="amber">&#9749; Breaks: <span className="text-[10px] font-black px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-700 border border-emerald-200">{breaksDone} Done</span><span className="text-slate-400">&bull;</span><span className="text-[10px] font-black px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-300">{breaksPending} Pending</span>{breakingNow > 0 && <><span className="text-slate-400">&bull;</span><span className="text-[10px] font-black px-1.5 py-0.5 rounded bg-rose-100 text-rose-700 border border-rose-200">{breakingNow} Out</span></>}</Chip>
              <div className="flex items-center gap-1 border border-amber-300 bg-amber-50/60 rounded-lg px-2 py-1">
                <span className="text-[11px] font-semibold text-slate-700 mr-1">Timer:</span>
                {[30, 45, 50].map((m) => <button key={m} disabled={!isToday || busy} onClick={() => run('breakDuration', { mins: m }, 'Break set to ' + m + ' min')} className={'px-2 py-0.5 rounded-md text-[11px] font-bold border ' + (S.breakDurationSetting === m ? 'bg-amber-700 text-white border-amber-700' : 'bg-white text-slate-600 border-slate-300') + ' disabled:opacity-40'}>{m}m</button>)}
              </div>
              {(S.helpStats || {}).raised > 0 && <Chip tone="rose">&#128680; Help: <b>{S.helpStats.raised}</b> &middot; avg {S.helpStats.accepted ? fmtSecsShort(S.helpStats.totalMs / S.helpStats.accepted / 1000) : '-'}{S.helpStats.escalated > 0 ? <b className="text-rose-700"> &middot; {S.helpStats.escalated} slow</b> : null}</Chip>}
              {((S.overstayDone || 0) + over.length) > 0 && <Chip tone="amber">&#9201; Overstays: <b>{(S.overstayDone || 0) + over.length}</b></Chip>}
              {forecastWarn.length > 0 && <Chip tone="amber">&#128302; Next break risk: {forecastWarn.map((f) => f.code + ' ' + f.after + '/' + f.min).join(', ')}</Chip>}
              <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Search name or ID..." className="border border-slate-300 rounded-lg px-3 py-1.5 text-xs outline-none focus:border-sky-600 w-36 bg-slate-50" />
              <div className="ml-auto flex items-center gap-1.5 flex-wrap">
                {shortages.length === 0 ? <Chip tone="emerald">&#10004; All workstations staffed</Chip>
                  : <Chip tone="rose">&#9888; Shortage: {shortages.map((x) => x.text).join(', ')}</Chip>}
              </div>
            </div>

            {view === 'board' && (
              <div className="max-w-[1700px] mx-auto px-4 pb-4 pt-1">
                {inspect && <div className="mb-2"><Btn small onClick={() => setInspect('')}>Show all lines</Btn></div>}
                <div className="grid grid-cols-[repeat(auto-fill,minmax(112px,1fr))] gap-2.5">
                  {ovCodes.map((c) => {
                    const d = defs[c]; const dis = !!disabled[c]; const br = breachMap[c]; const st = stat[c];
                    const mn = (S.minStaff || {})[c] || 0; const bad = st.kind === 'short' || !!br;
                    const pillTone = st.kind === 'short' ? 'bg-rose-100 text-rose-700 border-rose-200' : (st.kind === 'ok' || st.kind === 'extra') ? 'bg-emerald-100 text-emerald-700 border-emerald-200' : 'bg-slate-100 text-slate-600 border-slate-200';
                    return (
                      <div key={c} onClick={() => setModal({ type: 'lineinfo', code: c })} className={'cursor-pointer rounded-xl border p-2 shadow-sm transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md active:scale-[.97] ' + (inspect === c ? 'ring-2 ring-sky-500 ' : '') + (bad ? 'border-rose-400 bg-rose-50/60 ' : 'border-slate-200 bg-white ') + (br ? 'pulse-red ' : '') + (dis ? 'opacity-60' : '')}>
                        <div className="flex items-center justify-between gap-1">
                          <span className={'text-[10px] font-black text-white px-1.5 py-0.5 rounded ' + (d.headerBg || 'bg-slate-600')}>{c}</span>{fcMap[c] && <span title={'Next break would leave ' + fcMap[c].after + ' of minimum ' + fcMap[c].min} className="text-[9px] font-black text-amber-800 bg-amber-100 border border-amber-300 rounded px-1">&#9888; {fcMap[c].after}/{fcMap[c].min}</span>}
                          <button disabled={!canAct || busy} onClick={(e) => { e.stopPropagation(); run('toggleTask', { code: c }, dis ? c + ' enabled' : c + ' disabled'); }} className="text-[9px] font-semibold px-1.5 py-0.5 rounded border bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100 disabled:opacity-40">{dis ? 'Enable' : 'Disable'}</button>
                        </div>
                        <div className="text-[11px] font-bold text-slate-800 mt-1.5 truncate" title={d.name}>{d.name}</div>
                        <div className="flex items-center justify-between mt-1.5 text-[10px] text-slate-500" title={st.have - st.active > 0 ? (st.have - st.active) + ' on break' : 'Click for full details'}><span>Active:</span><span className={'font-bold rounded px-1.5 py-0.5 border ' + pillTone}>{st.active}/{st.planned}</span></div>
                        <div className="flex items-center justify-between mt-1.5 text-[10px] text-slate-500" onClick={(e) => e.stopPropagation()}>
                          <span className="leading-tight">Min<br />alarm:</span>
                          <div className="flex items-center gap-1">
                            <button disabled={!canAct || busy || mn <= 0} onClick={(e) => { e.stopPropagation(); run('minStaff', { code: c, n: mn - 1 }); }} className="w-5 h-5 rounded border border-slate-300 bg-white text-xs leading-none disabled:opacity-30">&minus;</button>
                            <span className={'text-xs font-bold w-4 text-center ' + (br ? 'text-rose-600' : 'text-slate-700')}>{mn > 0 ? mn : '–'}</span>
                            <button disabled={!canAct || busy} onClick={(e) => { e.stopPropagation(); run('minStaff', { code: c, n: mn + 1 }); }} className="w-5 h-5 rounded border border-slate-300 bg-white text-xs leading-none disabled:opacity-30">+</button>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                  <button disabled={!canAct} onClick={() => setModal({ type: 'addTask' })} className="rounded-xl border-2 border-dashed border-emerald-300 text-emerald-700 bg-emerald-50/40 hover:bg-emerald-50 disabled:opacity-40 min-h-[96px] flex flex-col items-center justify-center text-[11px] font-bold"><span className="text-xl leading-none">+</span>Add Task</button>
                </div>
              </div>
            )}
          </div>

          <main className="max-w-[1700px] mx-auto px-4 py-5 space-y-4">
            {view === 'board' && (
              <section className="grid grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] gap-3">
                {visibleCols.filter((c) => c.t !== 'break' || isToday).map((c, i) => (
                  <div key={c.t === 'break' ? 'BRK' : c.code} id={'box-' + (c.t === 'break' ? 'BRK' : c.code)} data-box={i} className={'h-[26rem] max-h-[75vh] scroll-mt-24 rise-in rounded-2xl transition-shadow ' + (dropOn === c.code ? 'ring-4 ring-sky-400' : '')}
                    onDragOver={(ev) => { if (c.t !== 'break' && canAct) { ev.preventDefault(); if (dropOn !== c.code) setDropOn(c.code); } }}
                    onDragLeave={() => { if (dropOn === c.code) setDropOn(''); }}
                    onDrop={(ev) => { if (c.t === 'break' || !canAct) return; ev.preventDefault(); setDropOn(''); let ids = []; try { ids = JSON.parse(ev.dataTransfer.getData('text/plain')) || []; } catch (x) {} if (ids.length) { run('swapMany', { empIds: ids, target: c.code }, (r) => 'Moved ' + r.moved + ' to ' + c.code); setSel({}); } }}>
                    {c.t === 'break' ? BreakCol() : LineCol({ code: c.code })}
                  </div>
                ))}
              </section>
            )}

            {view === 'roster' && <RosterTable {...{ S, emps, att, asg, selDay, isToday, canAct, matches, planFor, busy, run, callApi, setModal, eStatusBadge }} />}
            {view === 'audit' && <Audit history={history} />}
            {view === 'weekly' && <Weekly weekly={weekly} weekDays={weekDays} setWeekDays={setWeekDays} />}
          </main>

          {toastMsg && <div className="fixed bottom-4 left-1/2 -translate-x-1/2 z-[90] bg-slate-900 text-white text-xs font-semibold px-4 py-2 rounded-xl shadow-xl max-w-[90vw]">{toastMsg}</div>}
          {modal && <Modals {...{ modal, setModal, S, emps, att, asg, defs, run, callApi, busy, toast, nowSrv }} />}
        </div>
      );
    }

    function RosterTable({ S, emps, att, asg, selDay, isToday, canAct, matches, planFor, busy, run, callApi, setModal, eStatusBadge }) {
      const rows = emps.filter(matches);
      const label = { Present: 'Present', AB: 'Absent', LV: 'Leave', WO: 'Week Off', EO: 'Early Out' };
      return (
        <section className="bg-white border border-slate-200 rounded-xl">
          <div className="p-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200">
            <h2 className="text-xs font-bold text-slate-700 uppercase tracking-wide">Roster ({rows.length})</h2>
            <div className="flex gap-2">
              <Btn small tone="green" disabled={!canAct || busy} onClick={() => run('markAllPresent', {}, (r) => r.changed ? r.changed + ' marked present' : 'Everyone already present')}>&#10004; Mark all Present</Btn>
              <Btn small tone="blue" disabled={busy} onClick={() => setModal({ type: 'joiner' })}>+ Add Joiner</Btn>
            </div>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-xs">
              <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase"><tr><th className="text-left px-3 py-2">ID</th><th className="text-left px-3 py-2">Name</th><th className="text-left px-3 py-2">{isToday ? 'Plan / Now' : selDay + ' plan'}</th><th className="text-left px-3 py-2">Attendance</th><th className="text-left px-3 py-2">Notes</th><th className="px-3 py-2"></th></tr></thead>
              <tbody>
                {rows.map((e) => {
                  const a = asg[e.id] || {}; const s = att[e.id] || 'Present';
                  return (
                    <tr key={e.id} className="border-t border-slate-100 hover:bg-slate-50">
                      <td className="px-3 py-2 font-mono text-slate-500">{e.id}</td>
                      <td className="px-3 py-2 font-semibold">{e.name}</td>
                      <td className="px-3 py-2">{planFor(e, selDay)}{isToday && s === 'Present' && curStation(a, '') !== planFor(e, selDay) ? ' → ' + curStation(a, '') : ''}</td>
                      <td className="px-3 py-2">
                        <div className="flex items-center gap-1">
                          <select disabled={!isToday || busy} value={s} onChange={(ev) => {
                            const v = ev.target.value;
                            if (v === 'EO') setModal({ type: 'time', kind: 'early', emp: e });
                            else run('attendance', { empId: e.id, kind: v }, e.name + ': ' + label[v]);
                          }} className="border border-slate-300 rounded-md px-1.5 py-1 text-xs bg-white disabled:opacity-50">
                            {Object.keys(label).map((k) => <option key={k} value={k}>{label[k]}</option>)}
                          </select>
                          <Btn small disabled={!isToday || busy || s === 'WO' || s === 'AB' || s === 'LV'} onClick={() => setModal({ type: 'time', kind: 'late', emp: e })}>&#9200; Late</Btn>
                        </div>
                      </td>
                      <td className="px-3 py-2"><div className="flex gap-1 flex-wrap">{eStatusBadge(e)}</div></td>
                      <td className="px-3 py-2 text-right"><Btn small tone="ghost" disabled={busy} onClick={() => setModal({ type: 'delete', emp: e })}>&#128465;</Btn></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      );
    }

    function Audit({ history }) {
      const [open, setOpen] = useState('');
      if (history === null) return <div className="text-sm text-slate-500 p-6 text-center">Loading history...</div>;
      if (!history.length) return <div className="text-sm text-slate-500 p-6 text-center bg-white border border-slate-200 rounded-xl">No archived shifts yet. A record is saved automatically at 9:00 AM.</div>;
      return (
        <section className="space-y-2">
          {history.map((h, i) => {
            const k = (h.id || '') + i; const s = h.summary || {};
            return (
              <div key={k} className="bg-white border border-slate-200 rounded-xl">
                <button className="w-full text-left px-3 py-2.5 flex flex-wrap items-center justify-between gap-2" onClick={() => setOpen(open === k ? '' : k)}>
                  <div><div className="text-xs font-bold">{h.savedAt}</div><div className="text-[11px] text-slate-500">{h.day} &middot; staff {s.totalStaff} &middot; present {s.presentCount} &middot; absent {s.absentCount} &middot; week off {s.weekoffCount} &middot; breaks {s.breaksTakenCount}</div></div>
                  <span className="text-slate-400 text-xs">{open === k ? 'Hide' : 'Details'}</span>
                </button>
                {open === k && (
                  <div className="border-t border-slate-100 overflow-x-auto">
                    <table className="w-full text-[11px]"><thead className="bg-slate-50 text-slate-500 uppercase text-[10px]"><tr><th className="text-left px-3 py-1.5">Name</th><th className="text-left px-3 py-1.5">Attendance</th><th className="text-left px-3 py-1.5">Planned</th><th className="text-left px-3 py-1.5">Station</th><th className="text-left px-3 py-1.5">Role</th><th className="text-left px-3 py-1.5">Break</th></tr></thead>
                      <tbody>{(h.roster || []).map((r) => <tr key={r.id} className="border-t border-slate-100"><td className="px-3 py-1.5 font-semibold">{r.name}</td><td className="px-3 py-1.5">{r.attendance}</td><td className="px-3 py-1.5">{r.planned}</td><td className="px-3 py-1.5">{r.activeStation}</td><td className="px-3 py-1.5">{r.roleText}</td><td className="px-3 py-1.5">{r.breakSummary}</td></tr>)}</tbody></table>
                    {(!h.roster || !h.roster.length) && <div className="p-3 text-xs text-slate-400">No per-person detail stored for this record.</div>}
                  </div>
                )}
              </div>
            );
          })}
        </section>
      );
    }

    function Weekly({ weekly, weekDays, setWeekDays }) {
      const rows = (weekly && weekly.rows) || [];
      const tot = rows.reduce((t, r) => { Object.keys(r).forEach((k) => { if (typeof r[k] === 'number') t[k] = (t[k] || 0) + r[k]; }); return t; }, {});
      const fm = (m) => (m >= 60 ? Math.floor(m / 60) + 'h ' + String(m % 60).padStart(2, '0') + 'm' : m + 'm');
      return (
        <section className="bg-white border border-slate-200 rounded-xl">
          <div className="p-3 flex flex-wrap items-center justify-between gap-2 border-b border-slate-200">
            <div><h2 className="text-xs font-bold text-slate-700 uppercase tracking-wide">Weekly Record</h2>{weekly && weekly.success && <div className="text-[11px] text-slate-500">From {weekly.from} &middot; {weekly.shiftCount} shift(s) recorded</div>}</div>
            <div className="flex gap-1">{[7, 14, 30].map((d) => <button key={d} onClick={() => setWeekDays(d)} className={'px-2.5 py-1 rounded-md text-[11px] font-bold border ' + (weekDays === d ? 'bg-sky-700 text-white border-sky-700' : 'bg-white text-slate-600 border-slate-300')}>{d} days</button>)}</div>
          </div>
          {weekly === null ? <div className="p-6 text-center text-sm text-slate-500">Loading...</div> : !weekly.success ? <div className="p-6 text-center text-sm text-rose-600">{weekly.error || 'Could not load.'}</div> : rows.length === 0 ? <div className="p-6 text-center text-sm text-slate-500">No shifts recorded in this period yet.</div> : (
            <div className="overflow-x-auto">
              <table className="w-full text-xs">
                <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase"><tr>{['Name', 'On duty', 'Absent', 'Late (days)', 'Late (min)', 'Early outs', 'Helper time', 'Helper sessions', 'Break overstay (count)', 'Overstay (min)'].map((h) => <th key={h} className="text-left px-3 py-2 whitespace-nowrap">{h}</th>)}</tr></thead>
                <tbody>
                  {rows.map((r) => <tr key={r.id} className="border-t border-slate-100 hover:bg-slate-50"><td className="px-3 py-1.5 font-semibold">{r.name}</td><td className="px-3 py-1.5">{r.daysOnDuty}</td><td className="px-3 py-1.5">{r.absent}</td><td className="px-3 py-1.5">{r.lateCount}</td><td className="px-3 py-1.5">{r.lateMins}</td><td className="px-3 py-1.5">{r.earlyOuts}</td><td className="px-3 py-1.5">{fm(r.helperMins)}</td><td className="px-3 py-1.5">{r.helperSessions}</td><td className="px-3 py-1.5">{r.overstayCount}</td><td className="px-3 py-1.5">{r.overstayMins}</td></tr>)}
                  <tr className="border-t-2 border-slate-300 bg-slate-50 font-bold"><td className="px-3 py-2">Total</td><td className="px-3 py-2">{tot.daysOnDuty || 0}</td><td className="px-3 py-2">{tot.absent || 0}</td><td className="px-3 py-2">{tot.lateCount || 0}</td><td className="px-3 py-2">{tot.lateMins || 0}</td><td className="px-3 py-2">{tot.earlyOuts || 0}</td><td className="px-3 py-2">{fm(tot.helperMins || 0)}</td><td className="px-3 py-2">{tot.helperSessions || 0}</td><td className="px-3 py-2">{tot.overstayCount || 0}</td><td className="px-3 py-2">{tot.overstayMins || 0}</td></tr>
                </tbody>
              </table>
            </div>
          )}
        </section>
      );
    }

    function Modals({ modal, setModal, S, emps, att, asg, defs, run, callApi, busy, toast, nowSrv }) {
      const close = () => setModal(null);
      const [text, setText] = useState(modal.preset || '');
      const [target, setTarget] = useState('ALL');
      const [time, setTime] = useState(() => { try { return new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Riyadh', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(nowSrv())); } catch (e) { return ''; } });
      const [tcode, setTcode] = useState(''), [tname, setTname] = useState(''), [color, setColor] = useState(0);
      const [jn, setJn] = useState(''), [jid, setJid] = useState(''), [jtask, setJtask] = useState('PK'), [jwo, setJwo] = useState(''), [jpw, setJpw] = useState('');
      const lines = Object.keys(defs).filter((c) => !(S.disabledTasks || {})[c]);

      if (modal.type === 'nonsort') return <NsPopup S={S} busy={busy} run={run} close={close} />;
      if (modal.type === 'helplog') return <HelpLogPopup S={S} close={close} />;
      if (modal.type === 'lineinfo') return <LineInfoPopup S={S} code={modal.code} emps={S.employees || []} att={att} asg={asg} defs={defs} nowSrv={nowSrv} close={close} />;
      if (modal.type === 'report') return <ReportPopup S={S} close={close} nowSrv={nowSrv} toast={toast} />;
      if (modal.type === 'late') return <LatePopup S={S} close={close} />;
      if (modal.type === 'broadcast') return <BroadcastPopup S={S} close={close} callApi={callApi} busy={busy} toast={toast} />;
      if (modal.type === 'prod') return <ProductivityPopup close={close} ver={(S.prodVer || {}).v || (S.prodVer || {}).rows} />;

      if (modal.type === 'line') {
        const e = modal.emp; const isHelper = modal.mode === 'helper';
        return (
          <Modal title={(isHelper ? 'Deploy helper: ' : 'Swap line: ') + e.name} onClose={close}>
            <p className="text-xs text-slate-500 mb-3">{isHelper ? 'Temporary help. Their time on the other line is recorded.' : 'Permanently moves them to the chosen line for today.'}</p>
            <div className="grid grid-cols-2 gap-2">
              {lines.map((c) => <button key={c} disabled={busy} onClick={() => { close(); run(isHelper ? 'helperDeploy' : 'swap', { empId: e.id, target: c }, e.name + ' → ' + c); }} className={'text-left border rounded-lg px-3 py-2 text-xs hover:bg-slate-50 ' + 'border-slate-200'}><span className={'inline-block text-[10px] font-bold text-white px-1.5 py-0.5 rounded mr-1.5 ' + (defs[c].headerBg || 'bg-slate-600')}>{c}</span>{defs[c].name}</button>)}
            </div>
          </Modal>
        );
      }
      if (modal.type === 'call') {
        const e = modal.emp;
        return (
          <Modal title={'Call ' + e.name} onClose={close}>
            <p className="text-xs text-slate-500 mb-2">Their PDA will buzz until they acknowledge.</p>
            <div className="space-y-1.5 mb-3">{SUMMON_PRESETS.map((p) => <button key={p} onClick={() => setText(p)} className={'w-full text-left border rounded-lg px-3 py-1.5 text-xs ' + (text === p ? 'border-sky-600 bg-sky-50' : 'border-slate-200 hover:bg-slate-50')}>{p}</button>)}</div>
            <input value={text} onChange={(ev) => setText(ev.target.value)} maxLength={120} placeholder="Or type a reason" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-3 outline-none focus:border-sky-600" />
            <Btn tone="amber" disabled={busy || !text.trim()} onClick={() => { close(); run('ring', { empId: e.id, message: text.trim() }, 'Bell rung: ' + e.name); }}>&#128276; Ring bell</Btn>
          </Modal>
        );
      }
      if (modal.type === 'announce') {
        return (
          <Modal title="Announcement" onClose={close}>
            <label className="text-[11px] font-semibold text-slate-500">Send to</label>
            <select value={target} onChange={(ev) => setTarget(ev.target.value)} className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-3 mt-1"><option value="ALL">Everyone</option>{Object.keys(defs).map((c) => <option key={c} value={c}>{c} - {defs[c].name}</option>)}</select>
            <textarea rows={4} maxLength={240} value={text} onChange={(ev) => setText(ev.target.value)} placeholder="Message (max 240 characters)" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs outline-none focus:border-sky-600" />
            <div className="text-right text-[10px] text-slate-400 mb-3">{text.length} / 240</div>
            <Btn tone="blue" disabled={busy || !text.trim()} onClick={() => { close(); run('announce', { target, message: text.trim() }, 'Announcement sent'); }}>Send</Btn>
          </Modal>
        );
      }
      if (modal.type === 'time') {
        const e = modal.emp; const early = modal.kind === 'early';
        return (
          <Modal title={(early ? 'Early out: ' : 'Late arrival: ') + e.name} onClose={close}>
            <p className="text-xs text-slate-500 mb-2">{early ? 'Time they left. They are removed from their line.' : 'Time they arrived. Late minutes are counted from 12:00 AM.'}</p>
            <input type="time" value={time} onChange={(ev) => setTime(ev.target.value)} className="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm mb-3" />
            <Btn tone="blue" disabled={busy || !time} onClick={() => { close(); run('attendance', { empId: e.id, kind: modal.kind, time }, e.name + (early ? ' left at ' : ' arrived at ') + time); }}>Save</Btn>
          </Modal>
        );
      }
      if (modal.type === 'addTask') {
        return (
          <Modal title="Add workstation" onClose={close}>
            <input value={tcode} onChange={(ev) => setTcode(ev.target.value.toUpperCase())} maxLength={6} placeholder="Code (e.g. QC)" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-2" />
            <input value={tname} onChange={(ev) => setTname(ev.target.value)} maxLength={40} placeholder="Name (e.g. Quality Check)" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-2" />
            <div className="flex gap-1.5 mb-3 flex-wrap">{COLOR_CHOICES.map((c, i) => <button key={c.label} onClick={() => setColor(i)} className={'px-2 py-1 rounded text-[11px] text-white font-semibold ' + c.headerBg + (i === color ? ' ring-2 ring-offset-1 ring-slate-700' : '')}>{c.label}</button>)}</div>
            <Btn tone="blue" disabled={busy || !tcode.trim()} onClick={() => { const c = COLOR_CHOICES[color]; close(); run('addTask', { code: tcode.trim(), name: tname.trim(), headerBg: c.headerBg, pillBg: c.pillBg }, 'Workstation added'); }}>Add</Btn>
          </Modal>
        );
      }
      if (modal.type === 'joiner') {
        return (
          <Modal title="Add joiner (writes to the Roster sheet)" onClose={close}>
            <input value={jn} onChange={(ev) => setJn(ev.target.value)} placeholder="Full name" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-2" />
            <input value={jid} onChange={(ev) => setJid(ev.target.value)} placeholder="ID (leave empty to auto-create)" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-2" />
            <div className="grid grid-cols-2 gap-2 mb-2">
              <select value={jtask} onChange={(ev) => setJtask(ev.target.value)} className="border border-slate-300 rounded-lg px-2 py-2 text-xs">{Object.keys(defs).map((c) => <option key={c} value={c}>{c}</option>)}</select>
              <select value={jwo} onChange={(ev) => setJwo(ev.target.value)} className="border border-slate-300 rounded-lg px-2 py-2 text-xs"><option value="">Week off: none</option>{DAYS.map((d) => <option key={d} value={d}>Week off: {d}</option>)}</select>
            </div>
            <input value={jpw} onChange={(ev) => setJpw(ev.target.value)} placeholder="PDA password (optional)" className="w-full border border-slate-300 rounded-lg px-3 py-2 text-xs mb-3" />
            <Btn tone="blue" disabled={busy || !jn.trim()} onClick={() => { close(); callApi('addRosterEmployee', [jn.trim(), jid.trim(), jtask, jwo, jpw], 'Joiner added'); }}>Add to roster</Btn>
          </Modal>
        );
      }
      if (modal.type === 'delete') {
        const e = modal.emp;
        return (
          <Modal title="Remove from roster" onClose={close}>
            <p className="text-xs text-slate-600 mb-3">Delete <b>{e.name}</b> ({e.id}) from the Roster sheet? This cannot be undone from here.</p>
            <div className="flex gap-2"><Btn onClick={close}>Cancel</Btn><Btn tone="rose" disabled={busy} onClick={() => { close(); callApi('removeRosterEmployee', [e.id], 'Removed ' + e.name); }}>Delete</Btn></div>
          </Modal>
        );
      }
      if (modal.type === 'helpHelper') {
        const req = modal.req;
        const list = emps.filter((w) => att[w.id] === 'Present' && !(asg[w.id] || {}).onBreak && lc(w.id) !== lc(req.empId));
        return (
          <Modal title={'Send helper to ' + req.empName} onClose={close}>
            <p className="text-xs text-slate-500 mb-2">{req.location} ({req.station})</p>
            <div className="divide-y divide-slate-100 border border-slate-200 rounded-lg max-h-72 overflow-y-auto">
              {list.length === 0 && <div className="p-4 text-xs text-slate-400 text-center">No helpers available.</div>}
              {list.map((w) => <button key={w.id} disabled={busy} onClick={() => { close(); callApi('dispatchHelperToHelpCall', [req.id, w.id], 'Helper sent'); }} className="w-full text-left px-3 py-2 text-xs hover:bg-slate-50 flex justify-between"><span className="font-semibold">{w.name}</span><span className="text-slate-500">{curStation(asg[w.id], '')}</span></button>)}
            </div>
          </Modal>
        );
      }
      return null;
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>