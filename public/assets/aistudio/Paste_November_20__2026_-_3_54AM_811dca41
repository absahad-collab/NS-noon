<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Shift A Operations Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18.3.1/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone@7.24.7/babel.min.js"></script>
  <style>
    @keyframes redPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(225,29,72,.55); } 50% { box-shadow: 0 0 0 7px rgba(225,29,72,0); } }
    .pulse-red { animation: redPulse 1.8s infinite ease-in-out; }
    body.modal-open { overflow: hidden; }
    html { scroll-behavior: smooth; }
    .box-scroll { scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent; }
    @keyframes boxFlash { 0% { box-shadow: 0 0 0 0 rgba(3,105,161,0); } 18% { box-shadow: 0 0 0 6px rgba(3,105,161,.45); } 100% { box-shadow: 0 0 0 0 rgba(3,105,161,0); } }
    .box-flash { animation: boxFlash 1.6s ease-out 1; }
    @keyframes riseIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .rise-in { animation: riseIn .28s ease-out both; }
    body.dark { background: #0b1220 !important; color: #e2e8f0; }
    body.dark .bg-white { background: #131c31 !important; }
    body.dark .bg-slate-50, body.dark .bg-slate-100 { background: #18233d !important; }
    body.dark .bg-amber-50, body.dark .bg-amber-100 { background: #2d2610 !important; }
    body.dark .bg-rose-50, body.dark .bg-rose-100 { background: #34141c !important; }
    body.dark .bg-emerald-50, body.dark .bg-emerald-100 { background: #10291f !important; }
    body.dark .bg-sky-50, body.dark .bg-sky-100 { background: #0f2a3f !important; }
    body.dark [class*='bg-rose-50/'] { background: #34141c !important; }
    body.dark [class*='bg-amber-50/'] { background: #2d2610 !important; }
    body.dark [class*='bg-emerald-50/'], body.dark [class*='bg-sky-50/'] { background: #10291f !important; }
    body.dark .text-slate-900, body.dark .text-slate-800, body.dark .text-slate-700 { color: #e2e8f0 !important; }
    body.dark .text-slate-600, body.dark .text-slate-500, body.dark .text-slate-400 { color: #9fb0c8 !important; }
    body.dark .text-rose-900, body.dark .text-rose-700, body.dark .text-emerald-900, body.dark .text-emerald-700, body.dark .text-amber-900, body.dark .text-amber-800, body.dark .text-sky-900 { color: #f1f5f9 !important; }
    body.dark .border-slate-100, body.dark .border-slate-200, body.dark .border-slate-300 { border-color: #2a3857 !important; }
    body.dark input, body.dark select, body.dark textarea { background: #0f172a !important; color: #e2e8f0 !important; border-color: #2a3857 !important; }
    body.tv { zoom: 1.25; }
    @media print {
      body * { visibility: hidden !important; }
      .print-area, .print-area * { visibility: visible !important; }
      .print-area { position: absolute; left: 0; top: 0; width: 100%; padding: 16px; background: #fff !important; color: #000 !important; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .box-flash, .rise-in { animation: none; } }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased font-sans">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useMemo, useRef, useCallback } = React;

    const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const PRIORITY = ['FT', 'PK', 'BT'];
    const AFTER_ORDER = ['DIS', 'FL', 'CIR', 'HV', 'ST', 'TL', 'CON', 'LA'];
    const OVERVIEW_ORDER = ['FT', 'PK', 'BT', 'DIS', 'FL', 'CIR', 'HV', 'ST', 'TL', 'CON', 'LA'];
    const COLOR_CHOICES = [
      { label: 'Slate', headerBg: 'bg-slate-600', pillBg: 'bg-slate-100 text-slate-800 border-slate-200' },
      { label: 'Blue', headerBg: 'bg-sky-700', pillBg: 'bg-sky-100 text-sky-800 border-sky-200' },
      { label: 'Emerald', headerBg: 'bg-emerald-700', pillBg: 'bg-emerald-100 text-emerald-800 border-emerald-200' },
      { label: 'Amber', headerBg: 'bg-amber-600', pillBg: 'bg-amber-100 text-amber-800 border-amber-200' },
      { label: 'Rose', headerBg: 'bg-rose-700', pillBg: 'bg-rose-100 text-rose-800 border-rose-200' },
      { label: 'Violet', headerBg: 'bg-violet-700', pillBg: 'bg-violet-100 text-violet-800 border-violet-200' }
    ];
    const SUMMON_PRESETS = ['Report to TL desk immediately', 'Check your line right now', 'Break ended - return to line', 'Call your Floor Lead now'];

    const lc = (s) => String(s == null ? '' : s).trim().toLowerCase();

    function gs(name, args, ok, fail) {
      if (!(window.google && google.script && google.script.run)) { if (fail) fail('Not connected to the server.'); return; }
      const r = google.script.run
        .withSuccessHandler((res) => ok && ok(res))
        .withFailureHandler((e) => fail && fail((e && e.message) || 'Network problem.'));
      r[name].apply(r, args);
    }

    // ---------- audio ----------
    let audioCtx = null;
    function unlockAudio() {
      try {
        if (!audioCtx) { const AC = window.AudioContext || window.webkitAudioContext; if (AC) audioCtx = new AC(); }
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      } catch (e) {}
    }
    function beep(n) {
      try {
        unlockAudio(); if (!audioCtx) return;
        const t0 = audioCtx.currentTime;
        for (let i = 0; i < (n || 3); i++) {
          const o = audioCtx.createOscillator(), g = audioCtx.createGain();
          o.type = 'square'; o.frequency.setValueAtTime(1000, t0 + i * 0.25);
          g.gain.setValueAtTime(0.25, t0 + i * 0.25); g.gain.exponentialRampToValueAtTime(0.01, t0 + i * 0.25 + 0.2);
          o.connect(g); g.connect(audioCtx.destination); o.start(t0 + i * 0.25); o.stop(t0 + i * 0.25 + 0.2);
        }
      } catch (e) {}
    }
    document.addEventListener('click', unlockAudio);
    document.addEventListener('touchstart', unlockAudio, { passive: true });

    function fmtMMSS(ms) { ms = Math.max(0, ms); let s = Math.floor(ms / 1000); const m = Math.floor(s / 60); s = s % 60; return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0'); }
    function riyadhHHMM(ms) {
      try { return new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Riyadh', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(ms)); }
      catch (e) { return ''; }
    }
    function curStation(a, plan) {
      if (!a) return plan || '';
      if (a.activeStation && a.activeStation !== 'None') return a.activeStation;
      if (a.task1 && a.task1 !== 'None') return a.task1;
      return plan || '';
    }

    // ---------- small UI pieces ----------
    function Modal({ title, onClose, children, wide, size }) {
      return (
        <div className="fixed inset-0 z-[70] bg-slate-900/50 flex items-center justify-center p-4" onClick={onClose}>
          <div className={'bg-white rounded-2xl shadow-2xl w-full ' + (size === 'xxl' ? 'max-w-5xl' : size === 'xl' ? 'max-w-2xl' : wide ? 'max-w-lg' : 'max-w-sm') + ' max-h-[90vh] overflow-y-auto'} onClick={(e) => e.stopPropagation()}>
            <div className="flex items-center justify-between px-4 py-3 border-b border-slate-200">
              <h3 className="text-sm font-bold text-slate-800">{title}</h3>
              <button onClick={onClose} className="text-slate-400 hover:text-slate-700 text-lg leading-none px-1">&times;</button>
            </div>
            <div className="p-4">{children}</div>
          </div>
        </div>
      );
    }
    const Btn = ({ onClick, children, tone = 'slate', disabled, small, title }) => {
      const tones = {
        slate: 'bg-white text-slate-700 border-slate-300 hover:bg-slate-50',
        blue: 'bg-sky-700 text-white border-sky-700 hover:bg-sky-800',
        green: 'bg-emerald-700 text-white border-emerald-700 hover:bg-emerald-800',
        amber: 'bg-amber-500 text-white border-amber-500 hover:bg-amber-600',
        rose: 'bg-rose-600 text-white border-rose-600 hover:bg-rose-700',
        ghost: 'bg-transparent text-slate-600 border-transparent hover:bg-slate-100'
      };
      return <button title={title} disabled={disabled} onClick={onClick} className={'border rounded-lg font-semibold transition disabled:opacity-40 disabled:cursor-not-allowed ' + (small ? 'px-2 py-1 text-[11px]' : 'px-3 py-1.5 text-xs') + ' ' + tones[tone]}>{children}</button>;
    };

    const LinkBtn = ({ onClick, tone = 'text-slate-500', disabled, children }) => <button disabled={disabled} onClick={onClick} className={'text-[10px] font-bold hover:underline disabled:opacity-40 disabled:no-underline ' + tone}>{children}</button>;
    const CHIP_TONES = {
      slate: 'bg-slate-50 border-slate-200 text-slate-700', emerald: 'bg-emerald-50 border-emerald-200 text-emerald-800',
      rose: 'bg-rose-50 border-rose-200 text-rose-700', amber: 'bg-amber-50 border-amber-300 text-amber-800', sky: 'bg-sky-50 border-sky-200 text-sky-800'
    };
    const Chip = ({ tone = 'slate', children, className = '' }) => <span className={'inline-flex items-center gap-1.5 text-[11px] font-semibold border rounded-lg px-2 py-1 whitespace-nowrap ' + CHIP_TONES[tone] + ' ' + className}>{children}</span>;
    function fmt12(ms) {
      try { return new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Riyadh', hour: '2-digit', minute: '2-digit', hour12: true }).format(new Date(ms)); }
      catch (e) { return ''; }
    }

    // ---------- Non Sort popup ----------
    function NsReqCard({ r, busy, run }) {
      const [qty, setQty] = useState('');
      const valid = parseInt(qty, 10) >= 1;
      const send = () => { if (valid && !busy) run('nsSetCount', { id: r.id, count: parseInt(qty, 10) }, 'Count ' + qty + ' sent to ' + r.empName); };
      return (
        <div className={'rounded-xl border px-3 py-2.5 ' + (r.status === 'pending' ? 'bg-sky-50 border-sky-200' : 'bg-emerald-50 border-emerald-200')}>
          <div className="flex items-start justify-between gap-2">
            <div className="min-w-0">
              <div className="text-xs font-bold text-slate-800 truncate">{r.empName}</div>
              <div className="text-[11px] font-mono text-slate-600 break-all">AWB {r.awb}</div>
              <div className="text-[10px] text-slate-400">{r.timeStr}</div>
            </div>
            <button disabled={busy} onClick={() => run('nsCancel', { id: r.id }, 'Request removed')} title="Remove request" className="text-slate-400 hover:text-rose-600 text-lg leading-none px-1 disabled:opacity-40">&times;</button>
          </div>
          {r.status === 'pending' ? (
            <div className="flex items-center gap-2 mt-2">
              <input type="number" min="1" inputMode="numeric" value={qty} onChange={(e) => setQty(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') send(); }} placeholder="Enter Qty" className="flex-1 min-w-0 border border-sky-300 rounded-lg px-3 py-1.5 text-xs bg-white outline-none focus:border-sky-600" />
              <Btn tone="blue" disabled={busy || !valid} onClick={send}>Send count</Btn>
            </div>
          ) : (
            <div className="mt-2 text-[11px] font-semibold text-emerald-800">Count sent: <b>{r.count} Qty</b> &middot; waiting for {r.empName} to confirm putaway</div>
          )}
        </div>
      );
    }
    function NsPopup({ S, busy, run, close }) {
      const reqs = S.nonSortRequests || [];
      const board = S.sheetLeaderboard || [];
      const pending = reqs.filter((r) => r.status === 'pending');
      const ready = reqs.filter((r) => r.status !== 'pending');
      const totalAwb = board.reduce((n, x) => n + (x.awbs || 0), 0), totalQty = board.reduce((n, x) => n + (x.totalCount || 0), 0);
      const medal = (i) => (i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : String(i + 1));
      return (
        <Modal title={'📦 Non Sort'} onClose={close} size="xl">
          <div className="grid grid-cols-3 gap-2 mb-4">
            <div className={'rounded-xl border px-3 py-2 ' + (pending.length ? 'bg-rose-50 border-rose-200' : 'bg-slate-50 border-slate-200')}><div className="text-[10px] uppercase font-semibold text-slate-500">Need count</div><div className={'text-xl font-bold ' + (pending.length ? 'text-rose-700' : 'text-slate-700')}>{pending.length}</div></div>
            <div className="rounded-xl border bg-indigo-50 border-indigo-200 px-3 py-2"><div className="text-[10px] uppercase font-semibold text-slate-500">AWBs today</div><div className="text-xl font-bold text-indigo-700">{totalAwb}</div></div>
            <div className="rounded-xl border bg-emerald-50 border-emerald-200 px-3 py-2"><div className="text-[10px] uppercase font-semibold text-slate-500">Qty today</div><div className="text-xl font-bold text-emerald-700">{totalQty}</div></div>
          </div>

          <h4 className="text-[11px] font-bold uppercase tracking-wide text-slate-600 mb-2">Waiting for your count ({pending.length})</h4>
          <div className="space-y-2 mb-4">
            {pending.length === 0 && <div className="text-[11px] text-slate-400 italic border border-dashed border-slate-300 rounded-xl text-center py-4">No requests right now. When a CC scans an AWB it appears here.</div>}
            {pending.map((r) => <NsReqCard key={r.id} r={r} busy={busy} run={run} />)}
          </div>

          {ready.length > 0 && (
            <>
              <h4 className="text-[11px] font-bold uppercase tracking-wide text-slate-600 mb-2">Count sent, waiting for putaway ({ready.length})</h4>
              <div className="space-y-2 mb-4">{ready.map((r) => <NsReqCard key={r.id} r={r} busy={busy} run={run} />)}</div>
            </>
          )}

          <h4 className="text-[11px] font-bold uppercase tracking-wide text-slate-600 mb-2">Leaderboard (today)</h4>
          {board.length === 0 ? <div className="text-[11px] text-slate-400 italic">No Non Sort putaways yet today.</div> : (
            <div className="border border-slate-200 rounded-xl overflow-hidden">
              <table className="w-full text-xs">
                <thead className="bg-slate-50 text-slate-500 text-[10px] uppercase"><tr><th className="text-left px-3 py-1.5 w-10">#</th><th className="text-left px-3 py-1.5">Name</th><th className="text-right px-3 py-1.5">AWBs</th><th className="text-right px-3 py-1.5">Qty</th></tr></thead>
                <tbody>
                  {board.map((it, i) => (
                    <tr key={it.empName} className="border-t border-slate-100"><td className="px-3 py-1.5">{medal(i)}</td><td className="px-3 py-1.5 font-semibold">{it.empName}</td><td className="px-3 py-1.5 text-right text-indigo-700 font-semibold">{it.awbs}</td><td className="px-3 py-1.5 text-right text-emerald-700 font-bold">{it.totalCount}</td></tr>
                  ))}
                </tbody>
                <tfoot className="bg-slate-50 font-bold"><tr className="border-t border-slate-200"><td className="px-3 py-1.5"></td><td className="px-3 py-1.5">Total</td><td className="px-3 py-1.5 text-right text-indigo-700">{totalAwb}</td><td className="px-3 py-1.5 text-right text-emerald-700">{totalQty}</td></tr></tfoot>
              </table>
            </div>
          )}
          <div className="text-[10px] text-slate-400 mt-2">Synced with the "non sort" sheet.</div>
        </Modal>
      );
    }

    // ---------- shift report (WhatsApp text / print) ----------
    function lsGet(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
    function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
    function fmtSecsShort(n) { n = Math.round(Number(n) || 0); return n >= 60 ? Math.floor(n / 60) + 'm ' + (n % 60) + 's' : n + 's'; }
    function lateList(S) {
      const det = S.attendanceDetail || {};
      return (S.employees || []).filter((e) => det[e.id] && det[e.id].late).map((e) => ({ id: e.id, name: e.name, time: det[e.id].late.time, mins: det[e.id].late.mins })).sort((a, b) => b.mins - a.mins);
    }
    function prodLine(r) {
      if (!r || !r.success || !r.found) return '';
      const ppl = (r.people || []).filter((p) => p.hours >= 2 && p.ach != null);
      if (!ppl.length) return '';
      const by = ppl.slice().sort((a, b) => b.ach - a.ach);
      const top = by[0], low = by.filter((p) => p.ok === false).slice(-3).reverse();
      const on = ppl.filter((p) => p.ok).length;
      return 'Productivity ' + r.date + ': top ' + top.name + ' (' + top.tph + ' TPH, ' + pctTxt(top.ach) + ' of target) | on target ' + on + '/' + ppl.length + (low.length ? ' | lowest: ' + low.map((p) => p.name + ' ' + pctTxt(p.ach)).join(', ') : '');
    }
    function buildReport(S, nowMs, prodRep) {
      const emps = S.employees || [], att = S.attendance || {}, asg = S.assignments || {};
      const cnt = { p: 0, a: 0, eo: 0, wo: 0 };
      emps.forEach((e) => { const x = att[e.id]; if (x === 'Present') cnt.p++; else if (x === 'AB' || x === 'LV') cnt.a++; else if (x === 'EO') cnt.eo++; else if (x === 'WO') cnt.wo++; });
      const done = emps.filter((e) => asg[e.id] && asg[e.id].breakStatus === 'completed').length;
      const pend = emps.filter((e) => att[e.id] === 'Present' && asg[e.id] && asg[e.id].breakStatus === 'pending').length;
      const brkNow = emps.filter((e) => att[e.id] === 'Present' && asg[e.id] && asg[e.id].onBreak).length;
      const late = lateList(S);
      const absent = emps.filter((e) => att[e.id] === 'AB' || att[e.id] === 'LV').map((e) => e.name);
      const hs = S.helpStats || {};
      const avg = hs.accepted ? fmtSecsShort(hs.totalMs / hs.accepted / 1000) : '-';
      const ov = (S.overstayDone || 0) + (S.overstayBreaks || []).length;
      const L = [];
      L.push('*' + (S.shiftName || 'Shift A') + ' - ' + S.currentRealDay + ' ' + (S.currentDateStr || '') + '*  (' + fmt12(nowMs) + ')');
      L.push('Present ' + cnt.p + ' | Absent ' + cnt.a + ' | Week off ' + cnt.wo + ' | Early out ' + cnt.eo);
      L.push('Breaks: ' + done + ' done, ' + pend + ' pending, ' + brkNow + ' on break now');
      L.push('Break overstays: ' + ov + ((S.overstayBreaks || []).length ? ' (' + S.overstayBreaks.length + ' still over)' : ''));
      L.push('Help calls: raised ' + (hs.raised || 0) + ', accepted ' + (hs.accepted || 0) + ', avg response ' + avg + ', slowest ' + fmtSecsShort((hs.maxMs || 0) / 1000) + ', not accepted in 3+ min ' + (hs.escalated || 0));
      L.push('Late (' + late.length + '): ' + (late.length ? late.map((l) => l.name + ' ' + l.time + ' (+' + l.mins + 'm)').join(', ') : 'none'));
      L.push('Absent/Leave (' + absent.length + '): ' + (absent.length ? absent.join(', ') : 'none'));
      const br = S.minStaffBreaches || [];
      L.push('Min-staff breaches now: ' + (br.length ? br.map((b) => b.code + ' ' + b.active + '/' + b.min).join(', ') : 'none'));
      const lines = Object.keys(S.taskDefinitions || {}).map((c) => { const n = emps.filter((e) => att[e.id] === 'Present' && curStation(asg[e.id], '') === c).length; return n ? c + ' ' + n : ''; }).filter(Boolean);
      L.push('Active by line: ' + lines.join(' | '));
      const pl = prodLine(prodRep); if (pl) L.push(pl);
      return L.join('\n');
    }
    function copyText(t, done) {
      const fb = () => { try { const ta = document.createElement('textarea'); ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); const ok = document.execCommand('copy'); document.body.removeChild(ta); done(!!ok); } catch (e) { done(false); } };
      try { if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(t).then(() => done(true), fb); return; } } catch (e) {}
      fb();
    }
    function ReportPopup({ S, close, nowSrv, toast }) {
      const [prodRep, setProdRep] = useState(null);
      useEffect(() => { gs('getProductivityReport', [window.__dashToken || '', '', false], (r) => setProdRep(r), () => {}); }, []);
      const txt = buildReport(S, nowSrv(), prodRep);
      return (
        <Modal title={'📋 Shift report'} onClose={close} wide>
          <div className="print-area"><pre className="whitespace-pre-wrap text-xs leading-relaxed font-sans bg-slate-50 border border-slate-200 rounded-lg p-3">{txt.replace(/\*/g, '')}</pre></div>
          <div className="flex flex-wrap gap-2 mt-3">
            <Btn tone="blue" onClick={() => copyText(txt, (ok) => toast(ok ? 'Report copied - paste it in WhatsApp' : 'Could not copy'))}>Copy text</Btn>
            <Btn tone="green" onClick={() => { try { window.open('https://wa.me/?text=' + encodeURIComponent(txt), '_blank'); } catch (e) { toast('Could not open WhatsApp'); } }}>WhatsApp</Btn>
            <Btn onClick={() => { try { window.print(); } catch (e) { toast('Print is not available here'); } }}>Print / Save PDF</Btn>
          </div>
        </Modal>
      );
    }
    function LatePopup({ S, close }) {
      const late = lateList(S);
      const [trend, setTrend] = useState(null);
      useEffect(() => { gs('getAttendanceTrend', [window.__dashToken || '', 7], (r) => setTrend(r || { success: false }), () => setTrend({ success: false })); }, []);
      const rows = (trend && trend.rows) || [];
      const mx = Math.max(1, ...rows.map((r) => r.present + r.absent + r.weekOff));
      return (
        <Modal title={'⏰ Late today (' + late.length + ')'} onClose={close} wide>
          {late.length === 0 && <div className="text-xs text-slate-400 italic text-center py-3">Nobody is marked late today.</div>}
          <div className="space-y-1.5">
            {late.map((l) => (
              <div key={l.id} className="flex items-center justify-between gap-2 border border-amber-200 bg-amber-50 rounded-lg px-3 py-1.5 text-xs">
                <div className="min-w-0"><b>{l.name}</b> <span className="text-slate-400 font-mono">{l.id}</span></div>
                <div className="font-bold text-amber-800 whitespace-nowrap">arrived {l.time} &middot; +{l.mins} min</div>
              </div>
            ))}
          </div>
          <h4 className="text-[11px] font-bold uppercase text-slate-500 mt-4 mb-1.5">Attendance trend (last 7 days)</h4>
          {trend === null ? <div className="text-xs text-slate-400">Loading...</div> : !trend.success ? <div className="text-xs text-rose-600">{trend.error || 'Could not load the trend.'}</div> : rows.length === 0 ? <div className="text-xs text-slate-400 italic">No archived days yet - the trend fills in after each shift closes.</div> : (
            <div className="space-y-1">
              {rows.map((r) => (
                <div key={r.date} className="flex items-center gap-2 text-[11px]">
                  <span className="w-12 text-slate-500 font-mono">{r.date.slice(5)}</span>
                  <div className="flex-1 flex h-4 rounded overflow-hidden bg-slate-100">
                    <div className="bg-emerald-500" style={{ width: (r.present / mx * 100) + '%' }} title={'Present ' + r.present}></div>
                    <div className="bg-rose-500" style={{ width: (r.absent / mx * 100) + '%' }} title={'Absent ' + r.absent}></div>
                    <div className="bg-slate-400" style={{ width: (r.weekOff / mx * 100) + '%' }} title={'Week off ' + r.weekOff}></div>
                  </div>
                  <span className="w-40 text-slate-600">P {r.present} &middot; A {r.absent} &middot; Late {r.late}</span>
                </div>
              ))}
            </div>
          )}
        </Modal>
      );
    }

    // ---------- full line details popup (opened from the overview cards) ----------
    function LineInfoPopup({ S, code, emps, att, asg, defs, nowSrv, close }) {
      const d = defs[code] || {}; const now = nowSrv();
      const realDay = S.currentRealDay;
      const planOf = (e) => (e.plan && e.plan[realDay]) || 'PK';
      const here = emps.filter((e) => att[e.id] === 'Present' && curStation(asg[e.id], '') === code);
      const working = here.filter((e) => !(asg[e.id] || {}).onBreak);
      const onBrk = here.filter((e) => (asg[e.id] || {}).onBreak);
      const planned = emps.filter((e) => planOf(e) === code && att[e.id] !== 'WO');
      const missing = planned.filter((e) => !here.some((h) => h.id === e.id));
      const helpers = emps.filter((e) => att[e.id] === 'Present' && (asg[e.id] || {}).isHelping && (asg[e.id] || {}).originalStation === code);
      const pend = here.filter((e) => (asg[e.id] || {}).breakStatus === 'pending' && !(asg[e.id] || {}).onBreak).length;
      const done = here.filter((e) => (asg[e.id] || {}).breakStatus === 'completed').length;
      const mn = (S.minStaff || {})[code] || 0;
      const calls = (S.activeHelpRequests || []).filter((r) => r.station === code);
      const det = S.attendanceDetail || {};
      const lbl = { AB: 'Absent', LV: 'Leave', EO: 'Early out', WO: 'Week off' };
      const Stat = ({ k, v, tone }) => <div className={'rounded-lg border px-2.5 py-1.5 text-center ' + (tone || 'bg-slate-50 border-slate-200')}><div className="text-base font-black leading-tight">{v}</div><div className="text-[10px] text-slate-500 font-semibold">{k}</div></div>;
      return (
        <Modal title={code + ' - ' + (d.name || code)} onClose={close} wide>
          <div className="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-3">
            <Stat k="Planned" v={planned.length} />
            <Stat k="Working now" v={working.length} tone={working.length < planned.length - onBrk.length ? 'bg-rose-50 border-rose-200' : 'bg-emerald-50 border-emerald-200'} />
            <Stat k="On break" v={onBrk.length} tone="bg-amber-50 border-amber-200" />
            <Stat k="Breaks done" v={done} />
            <Stat k="Breaks pending" v={pend} />
            <Stat k="Min alarm" v={mn || '-'} />
          </div>
          {calls.length > 0 && <div className="mb-3 space-y-1">{calls.map((r) => <div key={r.id} className={'text-xs rounded-lg px-3 py-1.5 border ' + (r.escalated ? 'bg-rose-600 text-white border-rose-900' : 'bg-rose-50 border-rose-300 text-rose-900')}>&#128680; <b>{r.empName}</b> needs help at {r.location}{r.reason ? ' - ' + r.reason : ''} &middot; {r.status === 'accepted' ? 'accepted by ' + r.acceptedBy : 'waiting ' + Math.floor((r.waitMs || 0) / 60000) + ' min'}{r.imageUrl ? <span className="ml-2"><PhotoThumb url={r.imageUrl} h="h-8" /></span> : null}</div>)}</div>}
          <h4 className="text-[11px] font-bold uppercase text-slate-500 mb-1">Working now ({working.length})</h4>
          <div className="space-y-1 mb-3">
            {working.length === 0 && <div className="text-xs text-slate-400 italic">Nobody is working on this line right now.</div>}
            {working.map((e) => { const a = asg[e.id] || {}; const l = (det[e.id] || {}).late; return (
              <div key={e.id} className="flex items-center justify-between gap-2 border border-slate-200 rounded-lg px-3 py-1.5 text-xs">
                <div className="min-w-0"><b>{e.name}</b> <span className="text-slate-400 font-mono">{e.id}</span></div>
                <div className="flex flex-wrap gap-1 justify-end">
                  {a.isHelping ? <span className="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200 text-[10px] font-semibold">Helper (base {a.originalStation})</span> : a.swappedFrom ? <span className="px-1.5 py-0.5 rounded bg-indigo-100 text-indigo-800 border border-indigo-200 text-[10px] font-semibold">Covering (plan {a.swappedFrom})</span> : <span className="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 border border-slate-200 text-[10px] font-semibold">Primary</span>}
                  {l && <span className="px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200 text-[10px] font-semibold">Late {l.mins}m</span>}
                  <span className={'px-1.5 py-0.5 rounded border text-[10px] font-semibold ' + (a.breakStatus === 'completed' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-slate-50 text-slate-500 border-slate-200')}>{a.breakStatus === 'completed' ? 'Break done' : 'Break pending'}</span>
                </div>
              </div>); })}
          </div>
          {onBrk.length > 0 && (<>
            <h4 className="text-[11px] font-bold uppercase text-slate-500 mb-1">On break ({onBrk.length})</h4>
            <div className="space-y-1 mb-3">{onBrk.map((e) => { const a = asg[e.id] || {}; const diff = a.breakEndTime - now; return (
              <div key={e.id} className="flex items-center justify-between gap-2 border border-amber-200 bg-amber-50 rounded-lg px-3 py-1.5 text-xs"><div><b>{e.name}</b> <span className="text-slate-400 font-mono">{e.id}</span></div><div className={'font-mono font-bold ' + (diff < 0 ? 'text-rose-600' : 'text-amber-700')}>{diff < 0 ? 'overstay +' : ''}{fmtMMSS(Math.abs(diff))}</div></div>); })}</div>
          </>)}
          {missing.length > 0 && (<>
            <h4 className="text-[11px] font-bold uppercase text-slate-500 mb-1">Planned for {code} but not here ({missing.length})</h4>
            <div className="space-y-1 mb-3">{missing.map((e) => { const st = att[e.id]; const a = asg[e.id] || {}; return (
              <div key={e.id} className="flex items-center justify-between gap-2 border border-slate-200 rounded-lg px-3 py-1.5 text-xs"><div><b>{e.name}</b> <span className="text-slate-400 font-mono">{e.id}</span></div><div className="text-slate-600 font-semibold">{st === 'Present' ? 'now on ' + curStation(a, '') + (a.isHelping ? ' (helper)' : '') : (lbl[st] || st)}</div></div>); })}</div>
          </>)}
          {helpers.length > 0 && (<>
            <h4 className="text-[11px] font-bold uppercase text-slate-500 mb-1">Sent out as helpers ({helpers.length})</h4>
            <div className="space-y-1">{helpers.map((e) => <div key={e.id} className="text-xs border border-slate-200 rounded-lg px-3 py-1.5"><b>{e.name}</b> &rarr; {curStation(asg[e.id], '')}</div>)}</div>
          </>)}
        </Modal>
      );
    }

    // ---------- productivity (per task top 5, hour by hour, TPH) ----------
    const prettyType = (t) => String(t || '').replace(/_/g, ' ');
    const hourLbl = (h) => String(h).padStart(2, '0') + ':00';
    function shiftDateStr(d, n) { const x = new Date(d + 'T00:00:00Z'); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); }
    const pctTxt = (a) => (a == null ? '-' : Math.round(a * 100) + '%');
    const okCls = (ok) => (ok === false ? 'text-rose-600' : ok === true ? 'text-emerald-700' : 'text-slate-700');
    // load a productivity endpoint; reloads silently (no "Loading...") when the sheet version changes
    function useProd(op, key, args, ver, enabled) {
      const [data, setData] = useState(null); const keyRef = useRef('');
      useEffect(() => {
        if (!enabled) return undefined;
        let live = true; if (keyRef.current !== key) { setData(null); keyRef.current = key; }
        gs(op, args, (r) => { if (live) setData(r || { success: false }); }, () => { if (live) setData((cur) => (cur && cur.success ? cur : { success: false, error: 'Network problem.' })); });
        return () => { live = false; };
      }, [key, ver, enabled]);
      return data;
    }
    function gapVerdict(p) {
      const g = (p.gaps || []).length; if (!g) return '';
      const b = p.brk; if (!b) return 'no break data for this day';
      const cover = (b.breakMins || 0) + (b.overstayMins || 0) + (b.lateMins || 0);
      if (g * 60 <= cover + 20) return 'gap is about the same as break / late time';
      return 'gap is MORE than break + late (' + cover + 'm) - check the reason';
    }
    function ProductivityPopup({ close, ver }) {
      const [date, setDate] = useState('');
      const [allShifts, setAllShifts] = useState(false);
      const [sortBy, setSortBy] = useState('qty');
      const [tab, setTab] = useState('tasks');
      const [q, setQ] = useState('');
      const [open, setOpen] = useState('');
      const [task, setTask] = useState('');
      const [period, setPeriod] = useState(7);
      const tok = window.__dashToken || '';
      const data = useProd('getProductivityReport', 'r|' + date + '|' + allShifts, [tok, date, allShifts], ver, true);
      const curDate = date || (data && data.date) || '';
      const board = useProd('getProductivityBoard', 'b|' + curDate + '|' + allShifts + '|' + period, [tok, curDate, period, allShifts], ver, tab === 'board');
      const Row = ({ k, rank, name, qty, hours, tph, ok, badge, hoursList, sub }) => (
        <div className={'border rounded-lg overflow-hidden ' + (ok === false ? 'border-rose-200' : 'border-slate-200')}>
          <button onClick={() => setOpen(open === k ? '' : k)} className="w-full flex items-center gap-2 px-2.5 py-1.5 text-xs text-left hover:bg-slate-50 transition-colors">
            <span className="w-5 text-center font-black text-slate-400">{rank}</span>
            <span className="flex-1 min-w-0 truncate font-bold">{name} {badge}</span>
            <span className="w-14 text-right font-black text-sky-700">{qty}</span>
            <span className="w-12 text-right text-slate-500">{hours}h</span>
            <span className={'w-16 text-right font-black ' + okCls(ok)}>{tph} <span className="text-[9px] font-bold text-slate-400">TPH</span></span>
          </button>
          {open === k && (
            <div className="bg-slate-50 border-t border-slate-200 px-3 py-2">
              {sub}
              <div className="text-[10px] font-bold uppercase text-slate-400 mb-1">Hour by hour</div>
              <div className="flex flex-wrap gap-1.5">{hoursList}</div>
            </div>
          )}
        </div>
      );
      const hourChips = (list, showBy, gaps) => {
        const items = list.map((x) => ({ h: x.h, x })).concat((gaps || []).map((h) => ({ h, gap: true }))).sort((a, b) => a.h - b.h);
        return items.map((it) => it.gap ? (
          <div key={'g' + it.h} className="bg-rose-50 border border-dashed border-rose-300 rounded-md px-2 py-1 text-[11px] text-rose-600"><b>{hourLbl(it.h)}</b> <span className="font-black">gap</span></div>
        ) : (
          <div key={it.h} className="bg-white border border-slate-200 rounded-md px-2 py-1 text-[11px]">
            <b className="text-slate-700">{hourLbl(it.h)}</b> <span className="font-black text-sky-700">{it.x.qty}</span>
            {showBy && it.x.by && Object.keys(it.x.by).length > 1 ? <div className="text-[9px] text-slate-500">{Object.keys(it.x.by).map((t) => prettyType(t) + ' ' + it.x.by[t]).join(' · ')}</div> : null}
          </div>
        ));
      };
      const people = ((data && data.people) || []).filter((p) => !q.trim() || (p.name + ' ' + p.id).toLowerCase().includes(q.trim().toLowerCase()));
      const taskObj = task && data && data.tasks ? data.tasks.filter((t) => t.type === task)[0] : null;
      const taskHead = (t, clickable) => (
        <div className="mb-1.5">
          <button disabled={!clickable} onClick={() => { setTask(t.type); setOpen(''); }} className={'w-full flex items-center justify-between text-left ' + (clickable ? 'hover:text-sky-700' : '')}>
            <b className="text-sm capitalize">{prettyType(t.type)}{clickable ? ' ›' : ''}</b>
            <span className="text-[11px] text-slate-500">{t.total} units &middot; {t.people} people</span>
          </button>
          {t.target ? <div className="text-[10px] text-slate-500">Target {t.target}/hr &middot; <b className={t.onTarget === t.people ? 'text-emerald-700' : 'text-rose-600'}>{t.onTarget} of {t.people} on target</b></div> : null}
        </div>
      );
      const BoardCol = ({ title, list, kind }) => (
        <div className="border border-slate-200 rounded-xl p-2.5">
          <div className="text-sm font-black mb-1.5">{title}</div>
          <div className="space-y-1">
            {list.length === 0 && <div className="text-[11px] text-slate-400 italic">Not enough data yet.</div>}
            {list.map((p, i) => (
              <div key={p.id} className={'flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-xs ' + (i === 0 ? 'bg-amber-50 border border-amber-200' : 'border border-slate-200')}>
                <span className="w-6 text-center text-base">{['🥇', '🥈', '🥉'][i] || <span className="text-[11px] font-black text-slate-400">{i + 1}</span>}</span>
                <span className="flex-1 min-w-0 truncate font-bold">{p.name}</span>
                <span className="text-[10px] text-slate-500 whitespace-nowrap">{p.days}d &middot; {p.hours}h &middot; {p.tph} TPH</span>
                <span className={'w-14 text-right font-black ' + (kind === 'ach' ? okCls(p.ach >= 1) : 'text-sky-700')}>{kind === 'ach' ? pctTxt(p.ach) : p.total}</span>
              </div>
            ))}
          </div>
        </div>
      );
      return (
        <Modal title={'📈 Productivity - ' + (data && data.date ? data.date : '...')} onClose={close} size="xxl">
          <div className="flex flex-wrap items-center gap-2 mb-3 text-xs">
            <Btn small onClick={() => curDate && setDate(shiftDateStr(curDate, -1))}>&#9664;</Btn>
            <input type="date" value={curDate} onChange={(e) => e.target.value && setDate(e.target.value)} className="border border-slate-300 rounded-lg px-2 py-1 text-xs" />
            <Btn small onClick={() => curDate && setDate(shiftDateStr(curDate, 1))}>&#9654;</Btn>
            <label className="flex items-center gap-1 ml-1 text-slate-600"><input type="checkbox" checked={allShifts} onChange={(e) => setAllShifts(e.target.checked)} /> All shifts</label>
            <div className="ml-auto flex gap-1.5">
              <Btn small tone={tab === 'tasks' ? 'blue' : 'slate'} onClick={() => { setTab('tasks'); setTask(''); }}>Top 5 per task</Btn>
              <Btn small tone={tab === 'people' ? 'blue' : 'slate'} onClick={() => setTab('people')}>Everyone</Btn>
              <Btn small tone={tab === 'board' ? 'blue' : 'slate'} onClick={() => setTab('board')}>🏆 Best</Btn>
            </div>
          </div>
          {data === null && tab !== 'board' && <div className="text-xs text-slate-400 py-6 text-center">Loading...</div>}
          {data && !data.success && tab !== 'board' && <div className="text-xs text-rose-600 py-4 text-center">{data.error || 'Could not load productivity.'}</div>}
          {data && data.success && !data.found && tab !== 'board' && <div className="text-xs text-slate-400 italic py-6 text-center">No productivity data for {data.date}{allShifts ? '' : ' (my shift)'}.</div>}
          {data && data.success && data.found && tab === 'tasks' && !taskObj && (
            <div>
              <div className="flex items-center gap-1.5 mb-2 text-[11px] text-slate-500">Rank by:
                <Btn small tone={sortBy === 'qty' ? 'blue' : 'slate'} onClick={() => setSortBy('qty')}>Quantity</Btn>
                <Btn small tone={sortBy === 'tph' ? 'blue' : 'slate'} onClick={() => setSortBy('tph')}>TPH (min 2 hrs)</Btn>
                <span className="ml-auto">TPH = units per active hour &middot; <span className="text-rose-600 font-bold">red</span> = below target &middot; tap a task name for everyone</span>
              </div>
              <div className="grid md:grid-cols-2 gap-3">
                {data.tasks.map((t) => {
                  const list = sortBy === 'qty' ? t.topQty : t.topTph;
                  return (
                    <div key={t.type} className="border border-slate-200 rounded-xl p-2.5">
                      {taskHead(t, true)}
                      <div className="space-y-1">
                        {list.length === 0 && <div className="text-[11px] text-slate-400 italic">Nobody with 2+ active hours on this task.</div>}
                        {list.map((p, i) => <Row key={t.type + p.id} k={t.type + p.id} rank={i + 1} name={p.name} qty={p.qty} hours={p.hours} tph={p.tph} ok={p.ok} hoursList={hourChips(p.perHour, false)} />)}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
          {data && data.success && data.found && tab === 'tasks' && taskObj && (
            <div>
              <div className="flex items-center gap-1.5 mb-2 text-[11px] text-slate-500">
                <Btn small onClick={() => { setTask(''); setOpen(''); }}>&larr; All tasks</Btn>
                Sort:
                <Btn small tone={sortBy === 'qty' ? 'blue' : 'slate'} onClick={() => setSortBy('qty')}>Quantity</Btn>
                <Btn small tone={sortBy === 'tph' ? 'blue' : 'slate'} onClick={() => setSortBy('tph')}>TPH</Btn>
              </div>
              <div className="border border-slate-200 rounded-xl p-2.5">
                {taskHead(taskObj, false)}
                <div className="space-y-1">
                  {taskObj.all.slice().sort((a, b) => (sortBy === 'tph' ? b.tph - a.tph : b.qty - a.qty)).map((p, i) => (
                    <Row key={'a' + p.id} k={'a' + p.id} rank={i + 1} name={p.name} qty={p.qty} hours={p.hours} tph={p.tph} ok={p.ok} hoursList={hourChips(p.perHour, false)} />
                  ))}
                </div>
              </div>
            </div>
          )}
          {data && data.success && data.found && tab === 'people' && (
            <div>
              <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Search name or ID..." className="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-xs mb-2" />
              <div className="space-y-1">
                {people.map((p, i) => (
                  <Row key={'p' + p.id} k={'p' + p.id} rank={i + 1} name={p.name} qty={p.total} hours={p.hours} tph={p.tph} ok={p.ok}
                    badge={<span>{p.ach != null ? <span className={'text-[10px] font-black ' + okCls(p.ok)}>{pctTxt(p.ach)}</span> : null}{(p.gaps || []).length ? <span className="ml-1 text-[10px] font-black text-rose-600">⚠ {p.gaps.length} gap</span> : null}</span>}
                    hoursList={hourChips(p.perHour, true, p.gaps)}
                    sub={<div className="mb-2 space-y-1">
                      <div className="space-y-0.5">{p.types.map((t) => <div key={t.type} className="flex justify-between text-[11px]"><span className="capitalize">{prettyType(t.type)}{t.target ? <span className="text-slate-400"> (target {t.target}/h)</span> : null}</span><span><b>{t.qty}</b> in {t.hours}h &middot; <b className={okCls(t.ok)}>{t.tph}</b> TPH</span></div>)}</div>
                      {(p.gaps || []).length > 0 && <div className="text-[11px] text-rose-700 font-bold">⚠ No entries at {p.gaps.map(hourLbl).join(', ')} <span className="font-normal text-slate-500">- {gapVerdict(p)}</span></div>}
                      {p.brk && <div className="text-[11px] text-slate-600">Break {p.brk.breakMins}m{p.brk.overstayMins > 0 ? <b className="text-rose-600"> (+{p.brk.overstayMins}m over)</b> : null}{p.brk.lateMins > 0 ? <span> &middot; arrived late {p.brk.lateMins}m</span> : null}</div>}
                    </div>} />
                ))}
                {people.length === 0 && <div className="text-xs text-slate-400 italic text-center py-4">No match.</div>}
              </div>
            </div>
          )}
          {tab === 'board' && (
            <div>
              <div className="flex items-center gap-1.5 mb-2 text-[11px] text-slate-500">
                <Btn small tone={period === 7 ? 'blue' : 'slate'} onClick={() => setPeriod(7)}>Last 7 days</Btn>
                <Btn small tone={period === 30 ? 'blue' : 'slate'} onClick={() => setPeriod(30)}>Last 30 days</Btn>
                {board && board.success && <span className="ml-auto">{board.from} to {board.to} &middot; {board.people} people</span>}
              </div>
              {board === null && <div className="text-xs text-slate-400 py-6 text-center">Loading...</div>}
              {board && !board.success && <div className="text-xs text-rose-600 py-4 text-center">{board.error || 'Could not load.'}</div>}
              {board && board.success && board.people === 0 && <div className="text-xs text-slate-400 italic py-6 text-center">No productivity data in this period.</div>}
              {board && board.success && board.people > 0 && (
                <div className="grid md:grid-cols-2 gap-3">
                  <BoardCol title="🏆 Most units" list={board.topQty} kind="qty" />
                  <BoardCol title="🎯 Best vs target (4+ active hours)" list={board.topAch} kind="ach" />
                </div>
              )}
            </div>
          )}
        </Modal>
      );
    }

    // ---------- Broadcast: message / photo to the whole group (like a WhatsApp admin post) ----------
    function shrinkImage(file, done, fail) {
      const fr = new FileReader();
      fr.onerror = fail;
      fr.onload = () => {
        const im = new Image();
        im.onerror = fail;
        im.onload = () => {
          const k = Math.min(1, 1000 / Math.max(im.width, im.height));
          const c = document.createElement('canvas'); c.width = Math.round(im.width * k); c.height = Math.round(im.height * k);
          c.getContext('2d').drawImage(im, 0, 0, c.width, c.height);
          done(c.toDataURL('image/jpeg', 0.8));
        };
        im.src = fr.result;
      };
      fr.readAsDataURL(file);
    }
