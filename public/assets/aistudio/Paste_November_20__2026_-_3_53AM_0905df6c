function ensureSheet_(ss, name, headers) {
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    sh.appendRow(headers);
    sh.getRange(1, 1, 1, headers.length).setBackground('#0f172a').setFontColor('#ffffff').setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}
function empStats_(state, e) {
  var id = lc_(e.id);
  var h = state.helperWorkHistory.filter(function (x) { return lc_(x.empId) === id; });
  var b = state.breakWorkHistory.filter(function (x) { return lc_(x.empId) === id; });
  var det = state.attendanceDetail[e.id] || {};
  var st = { lateMins: det.late ? det.late.mins : 0, lateTime: det.late ? det.late.time : '', leftAt: det.left ? det.left.time : '',
    helperMins: 0, helperSessions: h.length, breakMins: 0, overstayMins: 0, overstayCount: 0 };
  h.forEach(function (x) { st.helperMins += x.mins; });
  b.forEach(function (x) { st.breakMins += x.actualMins; if (x.overtimeMins > 0) { st.overstayMins += x.overtimeMins; st.overstayCount++; } });
  return st;
}
function concludeShift_(state, now) {
  if (state.concluded) return;
  var end = shiftEndMs_(state.dateStr);
  state.errors = [];
  // 1. auto-close anything still running at shift end
  state.employees.forEach(function (e) {
    var a = state.assignments[e.id];
    if (!a) return;
    if (a.onBreak) closeBreak_(state, e, now, true, end);
    if (a.isHelping) closeHelper_(state, e, now, end);
  });
  (state.breachHistory || []).forEach(function (h) { if (!h.end) h.end = end; });
  (state.activeHelpRequests || []).forEach(function (r) { if (r.respMs == null && end - r.timestamp >= HELP_ESCALATE_MS) ensureHelpStats_(state).escalated++; });
  state.activeHelpRequests = []; state.activeSummons = []; state.nonSortRequests = [];
  (state.announcements || []).forEach(function (a) { a.ended = true; });

  // 2. rows + summary
  var counts = { Present: 0, AB: 0, LV: 0, WO: 0, EO: 0 };
  var lateCount = 0, overstayCount = 0, helperSessions = 0;
  var roster = state.employees.map(function (e) {
    var st = state.attendance[e.id] || 'Present';
    counts[st] = (counts[st] || 0) + 1;
    var a = state.assignments[e.id] || {};
    var s = empStats_(state, e);
    if (s.lateMins > 0) lateCount++;
    overstayCount += s.overstayCount; helperSessions += s.helperSessions;
    var role = 'Primary Operator';
    if (st === 'WO') role = 'Week Off';
    else if (st === 'AB') role = 'Absent';
    else if (st === 'LV') role = 'On Leave';
    else if (st === 'EO') role = 'Left early at ' + s.leftAt;
    else if (a.swappedFrom) role = 'Covering line (planned ' + a.swappedFrom + ')';
    else if (s.helperSessions > 0) role = 'Primary + helper (' + s.helperSessions + ' session(s), ' + fmtDuration_(s.helperMins) + ')';
    var brk = 'Pending';
    if (st === 'WO') brk = 'Rest Day';
    else if (s.breakMins > 0) brk = 'Done (' + s.breakMins + 'm' + (s.overstayMins > 0 ? ', +' + s.overstayMins + 'm late' : '') + ')';
    return {
      id: e.id, name: e.name, planned: plannedFor_(e, state.dayName), attendance: st,
      activeStation: st === 'EO' ? (a.leftFrom || 'None') : (a.activeStation || a.task1 || 'None'),
      roleText: role, breakSummary: brk, lateMins: s.lateMins, lateTime: s.lateTime, leftAt: s.leftAt,
      helperMins: s.helperMins, helperSessions: s.helperSessions, breakMins: s.breakMins, overstayMins: s.overstayMins, overstayCount: s.overstayCount
    };
  });
  var summary = {
    totalStaff: roster.length, presentCount: counts.Present, absentCount: counts.AB + counts.LV, leaveCount: counts.LV, absentOnlyCount: counts.AB,
    weekoffCount: counts.WO, earlyOutCount: counts.EO, lateCount: lateCount, breaksTakenCount: state.breakWorkHistory.length,
    overstayCount: overstayCount, helperSessions: helperSessions, breachCount: (state.breachHistory || []).length,
    helpRaised: (state.helpStats || {}).raised || 0, helpAccepted: (state.helpStats || {}).accepted || 0,
    helpAvgRespSecs: (state.helpStats && state.helpStats.accepted) ? Math.round(state.helpStats.totalMs / state.helpStats.accepted / 1000) : 0,
    helpMaxRespSecs: Math.round(((state.helpStats || {}).maxMs || 0) / 1000), helpEscalated: (state.helpStats || {}).escalated || 0
  };
  var snap = {
    id: 'snap-' + end + '-' + rid_(), createdAt: now, savedAt: fmt_(end, 'yyyy-MM-dd hh:mm a') + ' (Automated End-of-Shift)', savedBy: 'System Operations Scheduler',
    shift: SHIFT_NAME, day: state.dayName, dateStr: state.dateStr, summary: summary, roster: roster,
    breaches: (state.breachHistory || []).map(function (h) { return { code: h.code, min: h.min, minActive: h.minActive, start: fmt_(h.start, 'HH:mm'), end: fmt_(h.end, 'HH:mm') }; })
  };

  // 3. sheets
  var ss = null;
  try { ss = ss_(); } catch (e) { state.errors.push('open sheet: ' + e); }
  if (ss) {
    try {
      var daily = ensureSheet_(ss, 'Daily_Operations_Log', ['Date', 'Shift', 'Day', 'Employee ID', 'Employee Name', 'Attendance', 'Planned Task', 'Final Active Station', 'Role / Movement', 'Break Taken']);
      var drows = roster.map(function (r) { return [state.dateStr, SHIFT_NAME, state.dayName, r.id, r.name, r.attendance, r.planned, r.activeStation, r.roleText, r.breakSummary]; });
      if (drows.length) {
        var d0 = daily.getLastRow() + 1;
