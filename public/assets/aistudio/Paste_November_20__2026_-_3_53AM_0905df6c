    '<p><b>Present:</b> ' + s.presentCount + ' &nbsp; <b>Absent/Leave:</b> ' + s.absentCount + ' &nbsp; <b>Week off:</b> ' + s.weekoffCount + ' &nbsp; <b>Early out:</b> ' + s.earlyOutCount + ' &nbsp; <b>Late:</b> ' + s.lateCount + '</p>' +
    '<p><b>Breaks taken:</b> ' + s.breaksTakenCount + ' &nbsp; <b>Break overstays:</b> ' + s.overstayCount + ' &nbsp; <b>Helper sessions:</b> ' + s.helperSessions + ' &nbsp; <b>Min-staff breaches:</b> ' + s.breachCount + '</p>' +
    '<p><b>Help calls:</b> ' + (s.helpRaised || 0) + ' &nbsp; <b>Avg response:</b> ' + fmtSecs_(s.helpAvgRespSecs) + ' &nbsp; <b>Slowest:</b> ' + fmtSecs_(s.helpMaxRespSecs) + ' &nbsp; <b>Escalated (3+ min):</b> ' + (s.helpEscalated || 0) + '</p>' +
    table('Absent / Leave', absent, ['Name', 'ID', 'Type']) + table('Late arrivals', late, ['Name', 'ID', 'Arrived', 'Late by']) +
    table('Early outs', early, ['Name', 'ID', 'Left at']) + table('Break overstays', over, ['Name', 'ID', 'Count', 'Total']) +
