function plannedFor_(emp, dayName) {
  var p = emp && emp.plan ? String(emp.plan[dayName] || '').trim().toUpperCase() : '';
  return p || 'PK';
}
function newAssignment_(planned, dur) {
  var off = planned === 'WO';
  return {
    task1: off ? 'None' : planned, task2: 'None', activeStation: off ? 'None' : planned, originalStation: off ? 'None' : planned,
    isHelping: false, onBreak: false, breakStatus: 'pending', breakStartTime: null, breakEndTime: null, breakDurationMins: dur || 50,
    helperStartTime: null, helperStartTimeStr: null, coveringFor: '', swappedFrom: '', moveNote: null
  };
}
function defaultTaskStyle_(code) {
  return { name: code, badge: code, headerBg: 'bg-slate-600', pillBg: 'bg-slate-100 text-slate-800 border-slate-200' };
}
function ensureTaskDef_(state, code) {
  if (code && code !== 'WO' && code !== 'None' && !state.taskDefinitions[code]) { state.taskDefinitions[code] = defaultTaskStyle_(code); return true; }
  return false;
}
function stripEmp_(e) { return { id: e.id, name: e.name, plan: e.plan }; }

// ---------- Non Sort leaderboard (mirrors the "non sort" sheet for the business date) ----------
function readNsBoardFromSheet_(dateStr) {
  var sh = ss_().getSheetByName(NONSORT_SHEET);
  var board = {};
  if (!sh || sh.getLastRow() < 1) return board;
  var vals = sh.getRange(1, 1, sh.getLastRow(), 5).getValues();
  for (var i = 0; i < vals.length; i++) {
    var r = vals[i];
    var ds = r[0] instanceof Date ? fmt_(r[0].getTime(), 'yyyy-MM-dd') : String(r[0] == null ? '' : r[0]).trim().substr(0, 10);
    if (ds !== dateStr) continue;                         // also skips a header row, whatever it says
    var name = String(r[2] == null ? '' : r[2]).trim();
    if (!name) continue;
    var key = lc_(name);
    var o = board[key] || (board[key] = { empName: name, awbs: 0, totalCount: 0 });
    o.awbs += 1;
    o.totalCount += parseInt(r[4], 10) || 0;
  }
  return board;
}
function refreshNsBoard_(state) {
  try {
    var b = readNsBoardFromSheet_(state.dateStr);
    var changed = JSON.stringify(b) !== JSON.stringify(state.nsBoard || {});
    state.nsBoard = b;
    return changed;
  } catch (e) { return false; }
}
function nsLeaderboard_(state) {
  var b = state.nsBoard || {};
  return Object.keys(b).map(function (k) { return b[k]; }).sort(function (x, y) { return y.totalCount - x.totalCount || x.empName.localeCompare(y.empName); });
}
function appendNonSortRow_(state, req, now) {
  var ss = ss_();
  var sh = ss.getSheetByName(NONSORT_SHEET);
  if (!sh) {
    sh = ss.insertSheet(NONSORT_SHEET);
    sh.appendRow(['Date', 'Time', 'Employee Name', 'AWB Number', 'Quantity']);
    sh.getRange('A1:E1').setBackground('#0f172a').setFontColor('#ffffff').setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  var row = sh.getLastRow() + 1;
  sh.getRange(row, 1, 1, 4).setNumberFormat('@');         // keep date/time/AWB as plain text, exactly like the existing rows
  sh.getRange(row, 1, 1, 5).setValues([[state.dateStr, fmt_(now, 'h:mm a'), req.empName, req.awb, req.count]]);
}

function createDayState_(prev, biz, roster) {
  var emps = (roster && roster.length) ? roster : ((prev && prev.employees) || []);
