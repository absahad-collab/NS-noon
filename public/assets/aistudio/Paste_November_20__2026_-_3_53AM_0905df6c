      }
    } catch (e) { state.errors.push('daily log: ' + e); }
    try {
      var arch = ensureSheet_(ss, 'Shift_Archive', ['Saved At', 'Day', 'Total Staff', 'Present', 'Absent', 'Week Off', 'Breaks Taken', 'Helper Sessions', 'Snapshot JSON']);
      var js = JSON.stringify(snap);
      if (js.length > 49000) { var slim = clone_(snap); slim.roster = slim.roster.map(function (r) { return { id: r.id, name: r.name, planned: r.planned, attendance: r.attendance, activeStation: r.activeStation }; }); js = JSON.stringify(slim); }
      if (js.length > 49000) js = JSON.stringify({ savedAt: snap.savedAt, day: snap.day, summary: snap.summary, roster: [] });
      arch.appendRow([snap.savedAt, snap.day, summary.totalStaff, summary.presentCount, summary.absentCount, summary.weekoffCount, summary.breaksTakenCount, summary.helperSessions, js]);
    } catch (e) { state.errors.push('archive: ' + e); }
    try {
      var perf = ensureSheet_(ss, 'CC_Performance_Log', ['Date', 'Day', 'Employee ID', 'Employee Name', 'Attendance', 'Late Mins', 'Left Early At', 'Helper Mins', 'Helper Sessions', 'Break Mins', 'Overstay Mins', 'Overstay Count']);
      var prow = roster.map(function (r) { return [state.dateStr, state.dayName, r.id, r.name, r.attendance, r.lateMins, r.leftAt, r.helperMins, r.helperSessions, r.breakMins, r.overstayMins, r.overstayCount]; });
      if (prow.length) {
