  }

  // 4. e-mail + chat
  try { sendReport_(state, snap, false); } catch (e) { state.errors.push('email: ' + e); }
  pushChat_(SHIFT_NAME + ' ' + state.dateStr + ' closed. Present ' + summary.presentCount + ', absent ' + summary.absentCount + ', late ' + summary.lateCount + ', early out ' + summary.earlyOutCount + ', overstays ' + summary.overstayCount + ', min-staff breaches ' + summary.breachCount + ', help calls ' + summary.helpRaised + ' (avg response ' + fmtSecs_(summary.helpAvgRespSecs) + ', escalated ' + summary.helpEscalated + ').');
  state.concluded = true;
  state.concludedAt = now;
}

function fmtSecs_(n) { n = Math.round(Number(n) || 0); return n >= 60 ? Math.floor(n / 60) + 'm ' + (n % 60) + 's' : n + 's'; }
function reportRecipients_(state) {
