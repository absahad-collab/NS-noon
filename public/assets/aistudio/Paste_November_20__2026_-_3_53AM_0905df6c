// ============================== SMALL HELPERS ==============================
function nowMs_() { return new Date().getTime(); }
function fmt_(ms, f) { return Utilities.formatDate(new Date(ms), TZ, f); }
function rid_() { return Math.random().toString(36).substr(2, 6); }
function clone_(o) { return JSON.parse(JSON.stringify(o)); }
function lc_(s) { return String(s == null ? '' : s).trim().toLowerCase(); }
function esc_(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function pad2_(n) { return (n < 10 ? '0' : '') + n; }
function ss_() { return SpreadsheetApp.openById(SPREADSHEET_ID); }
function cache_() { return CacheService.getScriptCache(); }
function props_() { return PropertiesService.getScriptProperties(); }

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(12000);
  try { return fn(); } finally { try { lock.releaseLock(); } catch (e) {} }
}

function tzOffsetMs_(ms) {
  var z = fmt_(ms, 'Z');
  var sign = z.charAt(0) === '-' ? -1 : 1;
  return sign * (parseInt(z.substr(1, 2), 10) * 60 + parseInt(z.substr(3, 2), 10)) * 60000;
}
function bizInfo_(ms) {
  var s = ms - SHIFT_DAY_OFFSET_HOURS * 3600000;
  return { dateStr: fmt_(s, 'yyyy-MM-dd'), dayName: fmt_(s, 'EEE') };
}
function dateHourMs_(dateStr, hour) {
  var p = dateStr.split('-');
  var utc = Date.UTC(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10), hour, 0, 0);
  return utc - tzOffsetMs_(utc);
}
function shiftStartMs_(dateStr) { return dateHourMs_(dateStr, SHIFT_START_HOUR); }
function shiftLenHours_() { return SHIFT_END_HOUR > SHIFT_START_HOUR ? SHIFT_END_HOUR - SHIFT_START_HOUR : 24 - SHIFT_START_HOUR + SHIFT_END_HOUR; }
function shiftEndMs_(dateStr) { return shiftStartMs_(dateStr) + shiftLenHours_() * 3600000; }
function isShiftActiveAt_(ms) {
  var h = parseInt(fmt_(ms, 'H'), 10);
  if (SHIFT_START_HOUR < SHIFT_END_HOUR) return h >= SHIFT_START_HOUR && h < SHIFT_END_HOUR;
  return h >= SHIFT_START_HOUR || h < SHIFT_END_HOUR;
}
function hourLabel_(h) { var ap = h >= 12 && h < 24 ? 'PM' : 'AM'; var x = h % 12; return (x === 0 ? 12 : x) + ':00 ' + ap; }
function shiftLabel_() { return hourLabel_(SHIFT_START_HOUR) + ' - ' + hourLabel_(SHIFT_END_HOUR); }
function addDays_(dateStr, n) {
  var p = dateStr.split('-');
  var d = new Date(Date.UTC(parseInt(p[0], 10), parseInt(p[1], 10) - 1, parseInt(p[2], 10) + n));
  return d.getUTCFullYear() + '-' + pad2_(d.getUTCMonth() + 1) + '-' + pad2_(d.getUTCDate());
}
function normTime_(t) {
  var m = /^\s*(\d{1,2}):(\d{2})\s*$/.exec(String(t || ''));
  if (!m) return null;
  var h = parseInt(m[1], 10), mi = parseInt(m[2], 10);
  if (h > 23 || mi > 59) return null;
  return pad2_(h) + ':' + pad2_(mi);
}
function lateMins_(hhmm) {
  var p = hhmm.split(':');
  var h = parseInt(p[0], 10), t = h * 60 + parseInt(p[1], 10);
  if (SHIFT_START_HOUR >= 12 && h < 12) t += 1440;   // overnight shift: after midnight belongs to this shift
  return Math.max(0, t - SHIFT_START_HOUR * 60);
}
function fmtDuration_(mins) {
  mins = Math.max(0, Math.round(mins));
  if (mins < 60) return mins + 'm';
  return Math.floor(mins / 60) + 'h ' + pad2_(mins % 60) + 'm';
}

// ============================== STATE STORE (sheet + write-through cache) ==============================
function readStateSheet_() {
  var sh = ss_().getSheetByName(STATE_SHEET);
  if (!sh) return null;
  var n = sh.getLastRow();
  if (n < 1) return null;
  var vals = sh.getRange(1, 1, n, 1).getValues();
  var s = '';
  for (var i = 0; i < vals.length; i++) {
    var c = String(vals[i][0] == null ? '' : vals[i][0]);
    s += c.charAt(0) === 'J' ? c.substr(2) : c;    // chunks are stored as "J|" + text so Sheets never treats them as formulas/numbers
  }
  if (!s) return null;
  return JSON.parse(s);
}
function writeStateSheet_(json) {
  var ss = ss_();
  var sh = ss.getSheetByName(STATE_SHEET);
  if (!sh) {
    sh = ss.insertSheet(STATE_SHEET);
    try { sh.hideSheet(); } catch (e) {}
  }
  var chunks = [];
  for (var i = 0; i < json.length; i += SHEET_CHUNK) chunks.push(['J|' + json.substr(i, SHEET_CHUNK)]);
  if (!chunks.length) chunks.push(['J|']);
  var prev = sh.getLastRow();
  sh.getRange(1, 1, chunks.length, 1).setValues(chunks);
  if (prev > chunks.length) sh.getRange(chunks.length + 1, 1, prev - chunks.length, 1).clearContent();
}
function cacheWriteState_(json) {
  var ver = String(nowMs_()) + rid_();
  var obj = {}, n = 0;
  for (var i = 0; i < json.length; i += CACHE_CHUNK) { obj['ST_' + n] = ver + '|' + json.substr(i, CACHE_CHUNK); n++; }
  obj['ST_META'] = JSON.stringify({ ver: ver, n: n });
  cache_().putAll(obj, CACHE_TTL);
}
function cacheReadState_() {
  try {
    var c = cache_();
    var meta = c.get('ST_META');
    if (!meta) return null;
    meta = JSON.parse(meta);
    var keys = [];
    for (var i = 0; i < meta.n; i++) keys.push('ST_' + i);
    var got = c.getAll(keys);
    var s = '';
    for (var j = 0; j < keys.length; j++) {
      var v = got[keys[j]];
      if (!v || v.indexOf(meta.ver + '|') !== 0) return null;   // partial/mixed write -> treat as miss
      s += v.substr(meta.ver.length + 1);
    }
    return JSON.parse(s);
  } catch (e) { return null; }
}
function loadState_() {
  var st = cacheReadState_();
  if (st) return st;
  st = readStateSheet_();
  if (st) { try { cacheWriteState_(JSON.stringify(st)); } catch (e) {} }
  return st;
}
function saveState_(state) {
  state.rev = (state.rev || 0) + 1;
  var json = JSON.stringify(state);
  writeStateSheet_(json);
  try { cacheWriteState_(json); } catch (e) { try { cache_().remove('ST_META'); } catch (e2) {} }
}

// ============================== ROSTER ==============================
function systemSheet_(name) {
  return name === STATE_SHEET || name === 'Daily_Operations_Log' || name === 'Shift_Archive' || name === 'CC_Performance_Log';
}
function findRosterSheet_(ss) {
  var sheets = ss.getSheets();
  for (var i = 0; i < ROSTER_SHEET_NAMES.length; i++) {
    for (var j = 0; j < sheets.length; j++) {
      if (lc_(sheets[j].getName()) === lc_(ROSTER_SHEET_NAMES[i])) return sheets[j];
    }
  }
  for (var k = 0; k < sheets.length; k++) if (!systemSheet_(sheets[k].getName())) return sheets[k];
  return null;
}
function readRoster_() {
  try {
    var sheet = findRosterSheet_(ss_());
    if (!sheet) return null;
    var data = sheet.getDataRange().getValues();
    var out = [], seen = {};
    for (var i = 1; i < data.length; i++) {
      var r = data[i];
      var id = String(r[0] == null ? '' : r[0]).trim();
      if (!id || seen[lc_(id)]) continue;
      seen[lc_(id)] = true;
      var plan = {};
      for (var d = 0; d < 7; d++) {
        var v = String(r[2 + d] == null ? '' : r[2 + d]).trim().toUpperCase();
        plan[DAY_NAMES[d]] = v || 'PK';
      }
      out.push({
        id: id,
        name: String(r[1] || id).trim(),
        plan: plan,
        password: String(r[9] == null ? '' : r[9]).trim(),
        email: String(r[10] == null ? '' : r[10]).trim()
      });
    }
    return out;
  } catch (e) { return null; }
}
function getRoster_() {
  try {
    var c = cache_().get('ROSTER');
    if (c) return JSON.parse(c);
  } catch (e) {}
  var r = readRoster_();
  if (r) { try { var j = JSON.stringify(r); if (j.length < 90000) cache_().put('ROSTER', j, ROSTER_CACHE_TTL); } catch (e) {} }
  return r;
}
function clearRosterCache_() { try { cache_().remove('ROSTER'); cache_().remove('RSYNC'); } catch (e) {} }

// ============================== AUTH ==============================
function getTokens_() { try { return JSON.parse(props_().getProperty('TOKENS') || '{}'); } catch (e) { return {}; } }
function saveTokens_(t) {
  // Script Property values are limited to ~9 KB: drop the oldest sessions first if we ever get close
  var json = JSON.stringify(t);
  while (json.length > 8500) {
    var oldest = null;
    Object.keys(t).forEach(function (k) { if (oldest === null || t[k].iat < t[oldest].iat) oldest = k; });
    if (oldest === null) break;
    delete t[oldest]; json = JSON.stringify(t);
  }
  props_().setProperty('TOKENS', json);
}
function noPin_() { return !props_().getProperty('DASHBOARD_PIN'); }
function session_(token) {
  if (!token) return null;
  var t = getTokens_()[token];
  if (!t || t.exp <= nowMs_()) return null;
  return t;
}
function issueToken_(kind, empId) {
  return withLock_(function () {
    var now = nowMs_();
    var toks = getTokens_();
    Object.keys(toks).forEach(function (k) { if (toks[k].exp <= now) delete toks[k]; });
    var mine = Object.keys(toks).filter(function (k) {
      return toks[k].kind === kind && (kind === 'D' || lc_(toks[k].empId) === lc_(empId));
    }).sort(function (a, b) { return toks[a].iat - toks[b].iat; });
    var max = kind === 'D' ? MAX_DASH_TOKENS : MAX_TOKENS_PER_PERSON;
    while (mine.length >= max) delete toks[mine.shift()];
    var token = kind + Utilities.getUuid().replace(/-/g, '').substr(0, 24);
    toks[token] = { kind: kind, empId: empId || '', iat: now, exp: now + TOKEN_TTL_MS };
    saveTokens_(toks);
    return token;
  });
}
function rateKey_(prefix, id) { return 'RL_' + prefix + '_' + lc_(id); }
function rateLocked_(key) { return !!cache_().get(key + '_LOCK'); }
function rateFail_(key, limit) {
  var c = cache_();
  var n = (parseInt(c.get(key + '_N') || '0', 10) || 0) + 1;
  if (n >= limit) { c.put(key + '_LOCK', '1', 300); c.remove(key + '_N'); }
  else c.put(key + '_N', String(n), 300);
}
function rateOk_(key) { try { cache_().remove(key + '_N'); } catch (e) {} }

function dashLogin(pin) {
  try {
    var saved = props_().getProperty('DASHBOARD_PIN');
    if (!saved) return { success: true, noPin: true, token: issueToken_('D', '') };
    var key = rateKey_('PIN', 'dash');
    if (rateLocked_(key)) return { success: false, error: 'Too many wrong PINs. Try again in 5 minutes.' };
    if (String(pin == null ? '' : pin).trim() === String(saved)) {
      rateOk_(key);
      return { success: true, token: issueToken_('D', '') };
    }
    rateFail_(key, 5);
    return { success: false, error: 'Incorrect PIN.' };
  } catch (e) { return { success: false, error: String(e && e.message || e) }; }
}

function getLoginList() {
  try {
    var r = getRoster_() || [];
    return r.map(function (e) { return { id: e.id, name: e.name }; })
      .sort(function (a, b) { return a.name.localeCompare(b.name); });
  } catch (e) { return []; }
}

function verifyPdaPassword(empId, inputPassword) {
  try {
    var roster = getRoster_();
    if (!roster) return { success: false, error: 'Roster not available. Try again.' };
    var emp = null;
    for (var i = 0; i < roster.length; i++) if (lc_(roster[i].id) === lc_(empId)) { emp = roster[i]; break; }
    if (!emp) return { success: false, error: 'User profile not found. Please contact your team lead.' };
    var key = rateKey_('PW', emp.id);
    if (rateLocked_(key)) return { success: false, error: 'Too many wrong passwords. Try again in 5 minutes.' };
    var correct = String(emp.password || '').trim().toUpperCase();
    var entered = String(inputPassword == null ? '' : inputPassword).trim().toUpperCase();
    if (!correct || correct === entered) {
      rateOk_(key);
      return { success: true, name: emp.name, id: emp.id, token: issueToken_('P', emp.id) };
    }
    rateFail_(key, 8);
    return { success: false, error: 'Incorrect security password. Please try again.' };
  } catch (e) { return { success: false, error: String(e && e.message || e) }; }
}

function empById_(state, id) {
  var l = lc_(id);
  var list = state.employees || [];
  for (var i = 0; i < list.length; i++) if (lc_(list[i].id) === l) return list[i];
  return null;
}
function isTL_(state, id) {
  var e = empById_(state, id);
  if (!e) return false;
  var a = state.assignments[e.id] || {};
  return plannedFor_(e, state.dayName) === 'TL' || a.task1 === 'TL' || a.activeStation === 'TL';
}
function isFL_(state, id) {
  var e = empById_(state, id);
  if (!e) return false;
  var a = state.assignments[e.id] || {};
  return plannedFor_(e, state.dayName) === 'FL' || a.task1 === 'FL' || a.activeStation === 'FL';
}
// roles: 'dash' (dashboard PIN = superuser), 'tl', 'fl' (FL or TL), 'self', 'any'
function checkAuth_(state, token, roles, selfId) {
  var sess = session_(token);
  if (!sess) {
    if (noPin_() && roles.indexOf('dash') >= 0) return { ok: true, sess: { kind: 'D', empId: '', open: true } };
    return { ok: false, res: { success: false, code: 'AUTH', error: 'Session expired. Please log in again.' } };
  }
  if (sess.kind === 'D') return { ok: true, sess: sess };
  for (var i = 0; i < roles.length; i++) {
    var r = roles[i];
    if (r === 'any') return { ok: true, sess: sess };
    if (r === 'self' && selfId && lc_(selfId) === lc_(sess.empId)) return { ok: true, sess: sess };
    if (r === 'tl' && isTL_(state, sess.empId)) return { ok: true, sess: sess };
    if (r === 'fl' && (isFL_(state, sess.empId) || isTL_(state, sess.empId))) return { ok: true, sess: sess };
  }
  return { ok: false, res: { success: false, code: 'FORBIDDEN', error: 'You are not allowed to do this.' } };
}

