        html += '<div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-3.5 shadow-md"><div class="flex items-center justify-between ' + (ws.length ? 'mb-2.5 pb-2 border-b border-slate-700/70' : '') + '"><div class="flex items-center gap-2"><span class="text-[10px] font-black px-2 py-0.5 rounded-md text-white ' + stationBg(st, code) + '">' + esc(code) + '</span><span class="text-xs font-black text-white">' + esc(stationName(st, code)) + '</span></div><span class="text-[10px] font-black px-2.5 py-0.5 rounded-full bg-slate-900 text-slate-300 border border-slate-700">' + ws.length + '</span></div>';
