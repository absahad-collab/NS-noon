<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Shift A - CC PDA Portal</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes pulseAlert { 0%,100% { opacity: 1; } 50% { opacity: .88; } }
    .animate-pulse-alert { animation: pulseAlert 1.5s infinite ease-in-out; }
    @keyframes emergency { 0%,100% { box-shadow: 0 0 0 0 rgba(225,29,72,.75); } 50% { box-shadow: 0 0 0 10px rgba(225,29,72,0); } }
    .animate-emergency { animation: emergency 1.6s infinite ease-in-out; }
    body.modal-open { overflow: hidden; }
    select, input, textarea { font-size: 16px; }
    html { -webkit-text-size-adjust: 100%; }
    button, [data-act], select, input, textarea, label { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
    button, [data-act] { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; transition: transform .08s ease, background-color .15s ease, opacity .15s ease; }
    button:active, [data-act]:active { transform: scale(.97); opacity: .9; }
    button:disabled { opacity: .5; }
    #prodModal, #helpLocationModal, #sendHelperModal, #passwordModal, #bcModal, #ccSheet { overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
    #prodModal *, #helpLocationModal * { scroll-behavior: auto; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased min-h-screen pb-16">

  <!-- HEADER -->
  <header class="bg-slate-950 border-b border-slate-800 p-3 sticky top-0 z-40 flex items-center justify-between">
    <div class="flex items-center gap-2 min-w-0">
      <div class="p-1.5 bg-sky-700 rounded-lg text-white font-black text-xs">PDA</div>
      <div class="min-w-0">
        <h1 class="text-sm font-black tracking-tight text-white leading-tight truncate">Warehouse PDA</h1>
        <div class="flex items-center gap-1.5 text-[10px] text-slate-400">
          <span id="shiftStatusDot" class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
          <span id="shiftStatusLabel">Shift A &bull; Connecting...</span>
        </div>
      </div>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      <button id="enableSoundBtn" data-act="enableAlerts" class="px-2 py-1 bg-amber-500 text-slate-950 text-[10px] font-black rounded-lg">&#128276; Tap to enable</button>
      <button id="switchUserBtn" data-act="logout" class="hidden px-2.5 py-1 bg-slate-800 rounded-lg text-slate-300 text-xs font-bold">Switch ID</button>
    </div>
  </header>

  <!-- TABS -->
  <div id="navTabs" class="hidden bg-slate-950/95 border-b border-slate-800 p-1.5 flex gap-1.5 sticky top-[53px] z-30">
    <button id="tabMyTaskBtn" data-act="tab" data-tab="mytask" class="flex-1 py-1.5 rounded-lg text-xs font-black bg-sky-700 text-white" data-i18n="tab_my">My Task &amp; Schedule</button>
    <button id="tabAllTasksBtn" data-act="tab" data-tab="alltasks" class="flex-1 py-1.5 rounded-lg text-xs font-black text-slate-400 bg-slate-900 border border-slate-800" data-i18n="tab_all">All Tasks</button>
  </div>

  <div id="netBanner" class="hidden bg-amber-600 text-slate-950 text-[11px] font-black text-center py-1.5 px-3 sticky top-[53px] z-[35]"></div>
  <div class="max-w-md mx-auto px-3.5 pt-2 flex items-center justify-end gap-1.5">
    <button id="langBtn" data-act="cycleLang" class="px-2.5 py-1 bg-slate-800 border border-slate-700 rounded-lg text-[10px] font-black text-slate-200">&#127760; English</button>
    <button id="fontBtn" data-act="cycleFont" class="px-2.5 py-1 bg-slate-800 border border-slate-700 rounded-lg text-[10px] font-black text-slate-200">A</button>
  </div>

  <div id="toastBox" class="hidden fixed top-3 left-4 right-4 z-[60] bg-slate-700 text-white py-2 px-3 rounded-xl shadow-2xl text-center text-xs font-bold"></div>

  <div class="p-3.5 max-w-md mx-auto space-y-3.5">

    <!-- LOGIN -->
    <div id="loginScreen" class="bg-slate-800/90 border border-slate-700 rounded-2xl p-4 shadow-xl text-center mt-4">
      <h2 class="text-base font-black text-white" data-i18n="login_title">Select Your Name</h2>
      <p class="text-xs text-slate-400 mt-0.5 mb-3" data-i18n="login_sub">Choose your profile to log in to this terminal.</p>
      <input type="text" id="workerSearchInput" placeholder="Search name or ID..." class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white outline-none focus:border-sky-500 mb-3">
      <div id="workerListContainer" class="max-h-72 overflow-y-auto divide-y divide-slate-700/60 border border-slate-700 rounded-xl bg-slate-900/60 text-left">
        <div class="p-4 text-center text-slate-500 text-xs">Loading...</div>
      </div>
    </div>

    <!-- MY TASK -->
    <div id="myTaskSection" class="hidden space-y-3.5">

      <div id="mySummonAlarmBanner" class="hidden bg-gradient-to-r from-rose-700 to-red-800 text-white p-4 rounded-3xl shadow-2xl animate-emergency border-2 border-rose-300">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="text-[10px] font-black uppercase text-rose-200">&#128276; Supervisor calling you</div>
            <div id="summonTlSenderName" class="text-sm font-black text-white mt-1"></div>
            <p id="summonMessageText" class="text-xs font-bold text-amber-200 mt-0.5"></p>
          </div>
          <button data-act="ackSummon" class="px-3.5 py-2 bg-emerald-600 text-white font-black rounded-2xl text-xs shadow-lg active:scale-95 shrink-0">&#10004; Acknowledge</button>
        </div>
      </div>

      <div id="announcementBannerBox" class="space-y-2"></div>
      <div id="bcMsgsBox" class="hidden bg-slate-800/95 border border-sky-700/50 rounded-3xl p-3.5 shadow-lg space-y-2"></div>

      <div id="moveAlertBanner" class="hidden bg-sky-900 border-2 border-sky-400 text-white p-3.5 rounded-2xl shadow-xl">
        <div class="flex items-center justify-between gap-2">
          <div>
            <div class="text-[10px] font-black uppercase text-sky-200">Line update</div>
            <div id="moveAlertText" class="text-xs font-bold mt-0.5"></div>
          </div>
          <button data-act="dismissMove" class="px-3 py-1.5 bg-sky-600 text-white font-black rounded-xl text-xs shrink-0">OK</button>
        </div>
      </div>

      <div id="offDayBanner" class="hidden p-3.5 rounded-2xl border text-center">
        <div id="offDayTitle" class="text-sm font-black"></div>
        <div id="offDaySub" class="text-[11px] mt-0.5 opacity-80"></div>
      </div>

      <div id="closedBanner" class="hidden p-3 rounded-2xl border border-amber-700/70 bg-amber-950/50 text-amber-200 text-center text-xs font-bold"></div>

      <!-- FL help alerts -->
      <div id="flHelpAlertSection" class="hidden bg-rose-950/90 border-2 border-rose-500 rounded-3xl p-4 shadow-xl space-y-2.5">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-black text-rose-200 uppercase">&#128680; Floor Help Calls</h3>
          <span id="flHelpBadge" class="bg-rose-600 text-white text-[10px] font-black px-2 py-0.5 rounded-full">0</span>
        </div>
        <div id="flHelpListContainer" class="space-y-2"></div>
      </div>

      <!-- recent help activity (who accepted / cleared) for FL + TL -->
      <div id="helpActivityBox" class="hidden bg-slate-800/95 border border-emerald-700/60 rounded-3xl p-3.5 shadow-lg">
        <h3 class="text-[11px] font-black text-emerald-300 uppercase mb-2">&#128203; Help activity</h3>
        <div id="helpActivityList" class="space-y-1.5"></div>
      </div>

      <!-- TL deck -->
      <div id="tlCommandDeckSection" class="hidden space-y-3.5">
        <div class="bg-gradient-to-r from-slate-800 to-indigo-950 border border-indigo-500/60 rounded-3xl p-4 shadow-xl">
          <span class="text-[9px] font-black uppercase tracking-wider text-indigo-300 bg-indigo-950/90 px-2 py-0.5 rounded-md border border-indigo-700">Team Lead command</span>
          <h2 id="tlProfileName" class="text-base font-black text-white mt-1"></h2>
          <span id="tlProfileId" class="text-[10px] text-indigo-300/80 font-mono"></span>
        </div>

        <div id="tlTabs" class="sticky top-0 z-30 grid grid-cols-4 gap-1.5 bg-slate-950 py-1.5 text-[11px] font-black">
          <button data-act="tlTab" data-tab="floor" id="tlTabFloor" class="py-2 rounded-xl border">&#127981; Floor</button>
          <button data-act="tlTab" data-tab="help" id="tlTabHelp" class="py-2 rounded-xl border relative">&#128680; Help <span id="tlTabHelpN" class="hidden absolute -top-1.5 -right-1 bg-rose-600 text-white text-[9px] rounded-full px-1.5"></span></button>
          <button data-act="tlTab" data-tab="bc" id="tlTabBc" class="py-2 rounded-xl border">&#128226; Message</button>
          <button data-act="tlTab" data-tab="team" id="tlTabTeam" class="py-2 rounded-xl border">&#128101; Team</button>
        </div>

        <div id="tlBreachBanner" class="hidden bg-rose-900 border-2 border-rose-400 rounded-2xl p-3.5 animate-pulse-alert">
          <div class="text-[10px] font-black uppercase text-rose-200">Minimum staff breached</div>
          <div id="tlBreachList" class="text-xs font-bold text-white mt-1 space-y-0.5"></div>
        </div>

        <div id="tlPaneHelp" class="space-y-3.5">
        <div class="bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-700">
            <h3 class="text-xs font-black text-white flex items-center gap-1.5"><span>&#128680; Live Help Calls</span>
              <span id="tlHelpCallCountBadge" class="bg-rose-600 text-white text-[10px] px-1.5 rounded-full font-black">0</span></h3>
          </div>
          <div id="tlHelpCallsContainer" class="space-y-2"></div>
        </div>

        <div class="bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg space-y-2.5">
          <h3 class="text-xs font-black text-white">&#128231; Non Sort counts</h3>
          <div id="tlNsContainer" class="space-y-2"></div>
        </div>

        </div>
        <div id="tlPaneFloor" class="space-y-3.5">
          <div id="tlFloorBox" class="space-y-3"></div>
        <div class="bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg space-y-2.5">
          <div>
            <h3 class="text-xs font-black text-white">&#128276; Summon Colleague (Ring Bell)</h3>
            <p class="text-[10px] text-slate-400">Buzzer and urgent popup on the colleague's terminal</p>
          </div>
          <div>
            <label class="text-[10px] font-bold text-slate-400 block mb-1">Colleague:</label>
            <select id="tlSummonTargetSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500 font-bold"></select>
          </div>
          <div>
            <label class="text-[10px] font-bold text-slate-400 block mb-1">Reason:</label>
            <select id="tlSummonReasonSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500">
              <option value="Report to TL desk immediately">Report to TL desk immediately</option>
              <option value="Check your line right now">Check your line right now</option>
              <option value="Break ended - return to line">Break ended - return to line</option>
              <option value="Call your Floor Lead now">Call your Floor Lead now</option>
            </select>
          </div>
          <button id="tlRingBellSubmitBtn" data-act="ring" class="w-full py-2.5 bg-amber-500 text-slate-950 font-black rounded-xl text-xs shadow-lg active:scale-95">&#128276; Ring Bell &amp; Call Colleague</button>
        </div>

        <div class="bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg">
          <h3 class="text-xs font-black text-white mb-0.5">Deploy Line Helper</h3>
          <p class="text-[10px] text-slate-400 mb-3">Reassign an active colleague to another line temporarily</p>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="text-[10px] font-bold text-slate-400 block mb-1">Colleague:</label>
              <select id="tlDirectHelperWorkerSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-white outline-none focus:border-sky-500 font-bold truncate"></select>
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-400 block mb-1">Target line:</label>
              <select id="tlDirectHelperTaskSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-white outline-none focus:border-sky-500 font-bold"></select>
            </div>
          </div>
          <button data-act="deployHelper" class="w-full mt-2.5 py-2.5 bg-sky-700 text-white font-black rounded-xl text-xs shadow-md active:scale-95">Deploy as Helper</button>
        </div>

        </div>
        <div id="tlPaneBc" class="space-y-3.5">
          <div class="bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg space-y-2.5">
            <h3 class="text-xs font-black text-white">&#128226; New message to the group</h3>
            <input id="bcTitle" maxlength="60" placeholder="Title (optional)" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500 font-bold">
            <div>
              <textarea id="bcMsg" rows="4" maxlength="800" placeholder="Write the important message..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500"></textarea>
              <div id="bcCounter" class="text-right text-[10px] text-slate-500">0 / 800</div>
            </div>
            <div class="flex items-center gap-2">
              <label class="flex-1 text-center py-2.5 bg-slate-900 border border-dashed border-slate-500 rounded-xl text-xs font-black text-slate-200 cursor-pointer active:scale-95">&#128247; Add photo<input id="bcFile" type="file" accept="image/*" class="hidden"></label>
              <button id="bcPhotoClear" data-act="bcPhotoClear" class="hidden px-3 py-2.5 bg-slate-800 text-rose-300 rounded-xl text-xs font-black">&#10005; Remove</button>
            </div>
            <div id="bcPreviewWrap" class="hidden relative"><img id="bcPreview" alt="" class="rounded-xl max-h-52 mx-auto border border-slate-700"><div id="bcUpState" class="absolute inset-x-0 bottom-1 text-center text-[10px] font-black"></div></div>
            <div class="text-[10px] font-bold uppercase text-slate-400">Send to</div>
            <div id="bcTargetChips" class="flex flex-wrap gap-1.5"></div>
            <div id="bcPeopleBox" class="hidden space-y-1.5">
              <input id="bcPeopleSearch" placeholder="Search name..." class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-xs text-white outline-none focus:border-sky-500">
              <div id="bcPeopleList" class="max-h-44 overflow-y-auto grid grid-cols-2 gap-1"></div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div id="bcPrioBox" class="grid grid-cols-2 gap-1 text-[11px] font-black"></div>
              <select id="bcExpiry" class="bg-slate-900 border border-slate-700 rounded-xl p-2 text-xs text-white outline-none font-bold">
                <option value="shift">Until shift ends</option><option value="24h">24 hours</option><option value="3d">3 days</option><option value="manual">Until I remove it</option>
              </select>
            </div>
            <button id="bcSendBtn" data-act="bcSend" class="w-full py-3 bg-sky-600 text-white font-black rounded-xl text-sm shadow-lg active:scale-95">&#128226; Send to everyone selected</button>
          </div>
          <div id="bcActiveBox" class="space-y-2"></div>
          <div id="bcHistBox"></div>
        </div>
        <div id="tlPaneTeam" class="space-y-3.5">
          <button data-act="openProd" class="w-full py-2.5 bg-slate-800 border border-slate-600 text-white font-black rounded-xl text-xs active:scale-95">&#128200; Team productivity</button>
        <div class="hidden bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg space-y-2.5">
          <h3 class="text-xs font-black text-white">&#128226; Announcement</h3>
          <div>
            <label class="text-[10px] font-bold text-slate-400 block mb-1">Send to:</label>
            <select id="annTargetSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500 font-bold"></select>
          </div>
          <div>
            <textarea id="annMessageInput" rows="3" maxlength="240" placeholder="Message (max 240 characters)" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500"></textarea>
            <div id="annCounter" class="text-right text-[10px] text-slate-500">0 / 240</div>
          </div>
          <button id="annSendBtn" data-act="sendAnn" class="w-full py-2.5 bg-sky-700 text-white font-black rounded-xl text-xs active:scale-95">Send announcement</button>
          <div id="annActiveList" class="space-y-1.5"></div>
        </div>

        <div class="bg-slate-800/95 border border-slate-700 rounded-3xl p-4 shadow-lg space-y-2.5">
          <h3 class="text-xs font-black text-white">&#128203; Attendance</h3>
          <div class="grid grid-cols-2 gap-2">
            <div class="col-span-2">
              <label class="text-[10px] font-bold text-slate-400 block mb-1">Colleague:</label>
              <select id="attEmpSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500 font-bold"></select>
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-400 block mb-1">Action:</label>
              <select id="attKindSelect" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-sky-500 font-bold">
                <option value="Present">Present</option>
                <option value="AB">Absent</option>
                <option value="LV">Leave</option>
                <option value="late">Late</option>
                <option value="early">Early out</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-400 block mb-1">Time:</label>
              <input id="attTimeInput" type="time" class="w-full bg-slate-900 border border-slate-700 rounded-xl p-2 text-white outline-none focus:border-sky-500">
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <button data-act="applyAtt" class="py-2.5 bg-sky-700 text-white font-black rounded-xl text-xs active:scale-95">Apply</button>
            <button data-act="markAllPresent" class="py-2.5 bg-emerald-700 text-white font-black rounded-xl text-xs active:scale-95">&#10004; Mark all Present</button>
          </div>
          <div id="attSummary" class="grid grid-cols-3 gap-1.5 text-center"></div>
        </div>
        </div>
      </div>

      <!-- REGULAR CC -->
      <div id="regularCcViewSection" class="space-y-3.5">
        <div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-4 shadow-lg">
          <div class="flex items-center justify-between pb-3 border-b border-slate-700">
            <div class="min-w-0">
              <span class="text-[10px] font-bold text-sky-400 uppercase">Logged in</span>
              <h2 id="profileName" class="text-sm font-black text-white truncate"></h2>
              <span id="profileId" class="text-[10px] text-slate-400 font-mono"></span>
            </div>
            <div class="text-right shrink-0">
              <span class="text-[10px] text-slate-400 block">Today's plan</span>
              <span id="profilePlanBadge" class="text-xs font-black text-amber-300 bg-amber-950 px-2 py-0.5 rounded-lg"></span>
            </div>
          </div>
          <div class="pt-3">
            <div class="p-3 bg-slate-900/90 border border-slate-700 rounded-xl flex items-center gap-2.5">
              <span id="activeStationBadge" class="text-xs font-black px-2.5 py-1 rounded-lg text-white bg-sky-700"></span>
              <div>
                <div id="activeStationName" class="text-xs font-black text-white"></div>
                <div id="activeStationRole" class="text-[10px] text-slate-400">Primary</div>
              </div>
            </div>
          </div>
        </div>

        <div id="breakSectionCard" class="bg-slate-800/90 border border-slate-700 rounded-2xl p-4 shadow-lg">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xs font-black text-white"><span data-i18n="brk_title">Shift Break</span> <span id="breakDurLabel" class="text-slate-400 font-bold"></span></h3>
            <span id="breakStatusBadge" class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-700 text-slate-300">PENDING</span>
          </div>
          <div id="breakStartBox">
            <button id="startBreakBtn" data-act="breakStart" class="w-full py-3 bg-amber-500 text-slate-950 font-black rounded-xl text-xs active:scale-95 disabled:opacity-40" data-i18n="brk_start">Start my break now</button>
          </div>
          <div id="breakActiveBox" class="hidden space-y-3 p-3.5 rounded-2xl border border-amber-500/80 bg-amber-950/40">
            <div class="flex items-center justify-between">
              <span id="breakTimerLabel" class="text-xs font-bold text-amber-300">Break remaining</span>
              <span id="breakTimerCountdown" class="text-lg font-black text-amber-300 font-mono">--:--</span>
            </div>
            <div id="breakOvertimeWarn" class="hidden text-xs font-black text-rose-300 bg-rose-950/80 border border-rose-600 rounded-lg p-2 text-center"></div>
            <button id="endBreakBtn" data-act="breakEnd" class="w-full py-2.5 bg-emerald-600 text-white font-black rounded-xl text-xs active:scale-95" data-i18n="brk_end">End break &amp; return to station</button>
          </div>
          <div id="breakDoneBox" class="hidden p-3 bg-emerald-950 text-emerald-300 rounded-xl text-center text-xs font-bold" data-i18n="brk_done">&#10004; Break completed for this shift.</div>
        </div>

        <div id="myHelpBanner" class="hidden p-3.5 rounded-2xl border-2 border-amber-400 bg-amber-950/60">
          <div class="flex items-center justify-between gap-2">
            <div>
              <div class="text-[10px] font-black uppercase text-amber-300" data-i18n="my_help">Your help request</div>
              <div id="myHelpText" class="text-xs font-bold text-white mt-0.5"></div>
            </div>
            <div class="flex flex-col gap-1.5 shrink-0">
              <label id="myHelpPhotoBtn" class="px-2.5 py-1.5 bg-slate-800 text-sky-200 font-bold rounded-lg text-[10px] text-center cursor-pointer active:scale-95">&#128247; Add photo<input id="myHelpFile" type="file" accept="image/*" class="hidden"></label>
              <button data-act="cancelMyHelp" class="px-2.5 py-1.5 bg-slate-800 text-slate-200 font-bold rounded-lg text-[10px]">Cancel</button>
            </div>
          </div>
        </div>

        <div id="helpSectionCard" class="bg-slate-800/90 border border-rose-900 rounded-2xl p-3.5 shadow-lg flex items-center justify-between">
