          var a = assigns[w.id] || {};
          var isMe = me && lc(w.id) === lc(me.id);
          var tags = '';
          if (isToday && a.isHelping) tags += '<span class="text-[9px] font-black px-1.5 rounded-full bg-amber-500 text-slate-950">Helper</span>';
          if (isToday && a.swappedFrom) tags += '<span class="text-[9px] font-black px-1.5 rounded-full bg-indigo-500 text-white">Covering</span>';
          var right = isToday ? (a.onBreak ? '<span class="text-[10px] font-bold text-amber-400">On break</span>' : '<span class="text-[10px] text-slate-400">Assigned</span>') : '<span class="text-[10px] text-slate-400">Planned</span>';
          html += '<div class="flex items-center justify-between text-xs py-1"><div class="flex items-center gap-1.5 min-w-0"><span class="font-bold truncate ' + (isMe ? 'text-sky-300' : 'text-slate-100') + '">' + esc(w.name) + (isMe ? ' (You)' : '') + '</span>' + tags + '</div>' + right + '</div>';
        });
        html += '</div>';
      });
      // off groups
      function group(title, list, cls) {
        if (!list.length) return '';
        return '<div class="bg-slate-800/70 border border-slate-700 rounded-2xl p-3.5"><div class="text-[10px] font-black uppercase tracking-wider ' + cls + ' mb-1.5">' + title + ' (' + list.length + ')</div>' +
          list.map(function (x) { return '<div class="text-xs text-slate-200 py-0.5">' + esc(x) + '</div>'; }).join('') + '</div>';
      }
      var wo, lv, eo;
      if (isToday) {
        wo = emps.filter(function (e) { return att[e.id] === 'WO'; }).map(function (e) { return e.name; });
        lv = emps.filter(function (e) { return att[e.id] === 'LV' || att[e.id] === 'AB'; }).map(function (e) { return e.name + (att[e.id] === 'AB' ? ' (Absent)' : ' (Leave)'); });
        eo = emps.filter(function (e) { return att[e.id] === 'EO'; }).map(function (e) { var d = (st.attendanceDetail || {})[e.id]; return e.name + (d && d.left ? ' - left ' + d.left.time : ''); });
      } else {
        wo = emps.filter(function (e) { return e.plan && e.plan[S.rosterDay] === 'WO'; }).map(function (e) { return e.name; }); lv = []; eo = [];
      }
      html += group('Week off', wo, 'text-slate-400') + group('Leave / Absent', lv, 'text-rose-300') + group('Left early', eo, 'text-amber-300');
      setIfChanged($('allTasksListContainer'), html);
    }

    // ---------- send-helper modal ----------
    function openSendHelper(helpId) {
      var st = S.state; if (!st) return;
      var req = (st.activeHelpRequests || []).filter(function (r) { return r.id === helpId; })[0];
      if (!req) return;
      S.sendHelperFor = helpId;
      $('sendHelperSub').textContent = req.empName + ' at ' + req.location + ' (' + req.station + ')';
      var list = (st.employees || []).filter(function (w) {
        var a = st.assignments[w.id] || {};
        return st.attendance[w.id] === 'Present' && !a.onBreak && lc(w.id) !== lc(req.empId) && lc(w.id) !== lc(S.empId);
      });
      $('sendHelperList').innerHTML = list.length ? list.map(function (w) {
        var a = st.assignments[w.id] || {};
        return '<div data-act="pickHelper" data-id="' + esc(w.id) + '" class="p-2.5 flex items-center justify-between cursor-pointer active:bg-sky-900/40"><span class="text-xs font-bold text-white truncate">' + esc(w.name) + '</span><span class="text-[10px] font-black px-2 py-0.5 rounded text-white ' + stationBg(st, curStation(a, '')) + '">' + esc(curStation(a, '')) + '</span></div>';
      }).join('') : '<div class="p-4 text-center text-slate-500 text-xs">No helpers available.</div>';
      show('sendHelperModal', true); lockScroll();
    }
    function closeSendHelper() { show('sendHelperModal', false); lockScroll(); }

    // ---------- click delegation ----------
    function actKey(t) {
      return ['data-act', 'data-id', 'data-k', 'data-loc', 'data-tab', 'data-day', 'data-reason', 'data-sort'].map(function (n) { return t.getAttribute(n) || ''; }).join('|');
    }
    function actAt(x, y) { var e = document.elementFromPoint(x, y); return e && e.closest ? e.closest('[data-act]') : null; }
    // Touch: fire on finger-up, matched by key (not by node), so a re-render between down and up never swallows the tap.
    var PTR = null, ptrFired = { key: '', ts: 0 };
    document.addEventListener('pointerdown', function (ev) {
      if (ev.pointerType === 'mouse' || (ev.button != null && ev.button > 0)) return;
      var t = ev.target.closest ? ev.target.closest('[data-act]') : null;
      PTR = t ? { key: actKey(t), x: ev.clientX, y: ev.clientY, ts: Date.now(), id: ev.pointerId } : null;
    }, { passive: true });
    document.addEventListener('pointercancel', function () { PTR = null; }, { passive: true });
    document.addEventListener('pointerup', function (ev) {
      var d = PTR; PTR = null;
      if (!d || d.id !== ev.pointerId) return;
      if (Math.abs(ev.clientX - d.x) > 12 || Math.abs(ev.clientY - d.y) > 12 || Date.now() - d.ts > 1500) return;
      var t = actAt(ev.clientX, ev.clientY);
      if (!t || actKey(t) !== d.key) return;
      ptrFired = { key: d.key, ts: Date.now() };
      unlockAudio(); onTap(t);
    }, { passive: true });
    document.addEventListener('click', function (ev) {
      unlockAudio();
      var t = ev.target.closest ? ev.target.closest('[data-act]') : null;
      if (!t) return;
      if (ptrFired.key && Date.now() - ptrFired.ts < 700 && actKey(t) === ptrFired.key) { ptrFired.key = ''; return; }
      onTap(t);
    });
    function onTap(t) {
      var a = t.getAttribute('data-act'), id = t.getAttribute('data-id');
      switch (a) {
        case 'enableAlerts': enableAlerts(); break;
        case 'logout': doLogout(''); break;
        case 'tab': S.tab = t.getAttribute('data-tab'); render(); break;
        case 'rosterDay': S.rosterDay = t.getAttribute('data-day'); render(); break;
        case 'pickWorker': openPassword(id); break;
        case 'closePassword': closePassword(); break;
        case 'submitPassword': submitPassword(); break;
        case 'ackSummon': act('pdaAcknowledgeBell', [S.empId], 'Acknowledged'); break;
        case 'dismissMove': var m = S.state && findMe(S.state) && ((S.state.assignments || {})[findMe(S.state).id] || {}).moveNote; if (m) store('pda_move_seen', m.id); render(); break;
        case 'ackAnn': act('ackAnnouncement', [S.empId, id], 'Thanks', 'ack-' + id); break;
        case 'breakStart': act('pdaSetBreakAction', [S.empId, 'start'], 'Break started'); break;
        case 'breakEnd': act('pdaSetBreakAction', [S.empId, 'end'], function (r) { return r.overtimeMins > 0 ? 'Break ended (+' + r.overtimeMins + ' min overtime logged)' : 'Break completed on time'; }); break;
        case 'openHelp': helpPhotoReset(); S.helpReason = ''; renderReasonChips(); show('helpLocationModal', true); lockScroll(); break;
        case 'pickReason': S.helpReason = S.helpReason === t.getAttribute('data-reason') ? '' : t.getAttribute('data-reason'); renderReasonChips(); break;
        case 'cycleLang': var li = 0; LANGS.forEach(function (x, i) { if (x[0] === S.lang) li = i; }); S.lang = LANGS[(li + 1) % LANGS.length][0]; store('pda_lang', S.lang); applyPrefs(); S.state && render(); break;
        case 'refreshDevices': loadDevices(true); break;
        case 'cycleFont': S.fs = (S.fs + 1) % 4; store('pda_fs', String(S.fs)); applyPrefs(); break;
        case 'openProd': openProd(); break;
        case 'closeProd': show('prodModal', false); lockScroll(); break;
        case 'prodPrev': if (P.date) { P.date = shiftDate(P.date, -1); $('prodDate').value = P.date; loadProd(); } break;
        case 'prodNext': if (P.date) { P.date = shiftDate(P.date, 1); $('prodDate').value = P.date; loadProd(); } break;
        case 'prodTab': P.tab = t.getAttribute('data-tab'); P.open = ''; renderProd(); if (P.tab === 'board') loadBoard(); break;
        case 'prodPeriod': P.period = parseInt(t.getAttribute('data-sort'), 10) === 30 ? 30 : 7; loadBoard(); break;
        case 'prodSort': P.sort = t.getAttribute('data-sort'); P.open = ''; renderProd(); break;
        case 'prodOpen': P.open = P.open === t.getAttribute('data-k') ? '' : t.getAttribute('data-k'); renderProd(); break;
        case 'closeHelp': show('helpLocationModal', false); lockScroll(); break;
        case 'sendHelp':
          if (S.helpImg && S.helpImg.up === 'busy') { toast('Photo is still uploading...'); break; }
          show('helpLocationModal', false); lockScroll(); act('pdaRaiseHelpRequest', [S.empId, t.getAttribute('data-loc'), S.helpReason, (S.helpImg && S.helpImg.id) || ''], 'Help alert sent'); S.helpReason = ''; helpPhotoReset(); break;
        case 'helpPhotoClear': helpPhotoReset(); break;
        case 'photoOpen': $('photoViewImg').src = id; show('photoView', true); lockScroll(); break;
        case 'photoClose': show('photoView', false); $('photoViewImg').removeAttribute('src'); lockScroll(); break;
        case 'cancelMyHelp': var mh = (S.state.activeHelpRequests || []).filter(function (r) { return lc(r.empId) === lc(S.empId); })[0]; if (mh) act('resolveHelpRequest', [mh.id], 'Help request cancelled'); break;
        case 'acceptHelp': act('flAcceptHelpRequest', [id, S.empId], 'Help call accepted', 'acc-' + id); break;
        case 'clearHelp': act('resolveHelpRequest', [id], 'Help call cleared', 'clr-' + id); break;
        case 'openSendHelper': openSendHelper(id); break;
        case 'closeSendHelper': closeSendHelper(); break;
        case 'pickHelper': closeSendHelper(); act('dispatchHelperToHelpCall', [S.sendHelperFor, id], function (r) { return (r.helperName || 'Helper') + ' sent'; }); break;
        case 'ring':
          var tgt = $('tlSummonTargetSelect').value;
          if (!tgt) { toast('Select a colleague first.'); break; }
          act('pdaRingWorkerBell', [tgt, $('tlSummonReasonSelect').value, $('tlProfileName').textContent], 'Bell rung. Colleague terminal is buzzing.'); break;
        case 'deployHelper':
          var w = $('tlDirectHelperWorkerSelect').value, tk = $('tlDirectHelperTaskSelect').value;
          if (!w || !tk) { toast('Select a colleague and a line.'); break; }
          act('pdaDeployHelperDirect', [w, tk], 'Deployed as helper to ' + tk); break;
        case 'noop': break;
        case 'tlTab': bcInit(); S.tlTab = t.getAttribute('data-tab'); render(); break;
        case 'bcTarget':
          bcInit(); var kk = t.getAttribute('data-k');
          if (kk === 'ALL') { S.bc.all = true; S.bc.lines = {}; S.bc.ids = {}; S.bc.people = false; }
          else if (kk === 'PEOPLE') { S.bc.people = !S.bc.people; }
          else { S.bc.lines[kk] = !S.bc.lines[kk]; }
          S.bc.all = !bcChosenLines().length && !bcChosenIds().length; renderBcCompose(S.state); break;
        case 'bcPerson': bcInit(); S.bc.ids[id] = !S.bc.ids[id]; S.bc.all = !bcChosenLines().length && !bcChosenIds().length; renderBcCompose(S.state); break;
        case 'bcPrio': bcInit(); S.bc.prio = t.getAttribute('data-k') === 'urgent' ? 'urgent' : 'normal'; renderBcCompose(S.state); break;
        case 'bcPhotoClear': bcInit(); S.bc.imgData = ''; S.bc.imgId = ''; S.bc.up = ''; $('bcFile').value = ''; show('bcPreviewWrap', false); show('bcPhotoClear', false); $('bcPreview').removeAttribute('src'); renderBcCompose(S.state); break;
        case 'bcSend': sendBc(); break;
        case 'bcAck': act('ackBroadcast', [S.empId, id, t.getAttribute('data-k')], 'Thanks', 'bc-' + id); break;
        case 'bcZoom': S.bcZoom = !S.bcZoom; render(); break;
        case 'bcOpen': S.bcView = id; render(); break;
        case 'bcClose': S.bcView = ''; render(); break;
        case 'bcUnseen': bcInit(); S.bcUnseenOpen[id] = !S.bcUnseenOpen[id]; render(); break;
        case 'bcRemind': act('remindBroadcast', [id], 'Reminder sent', 'bcr-' + id); break;
        case 'bcEnd': act('endBroadcast', [id], 'Message ended', 'bce-' + id); break;
        case 'ccOpen': S.sheet = { id: id, mode: 'main' }; render(); break;
        case 'ccClose': S.sheet = null; render(); break;
        case 'ccMode': if (S.sheet) { S.sheet.mode = t.getAttribute('data-k'); render(); } break;
        case 'ccMove': S.sheet = null; act('tlAction', ['swap', { empId: id, target: t.getAttribute('data-k') }], 'Moved to ' + t.getAttribute('data-k'), 'cc-' + id); render(); break;
        case 'ccBreakStart': S.sheet = null; act('tlAction', ['breakStart', { empId: id }], 'Break started', 'cc-' + id); render(); break;
        case 'ccBreakEnd': S.sheet = null; act('tlAction', ['breakEnd', { empId: id }], 'Break ended', 'cc-' + id); render(); break;
        case 'ccHelper': S.sheet = null; act('tlAction', ['helperDeploy', { empId: id, target: t.getAttribute('data-k') }], 'Sent as helper to ' + t.getAttribute('data-k'), 'cc-' + id); render(); break;
        case 'ccHelperBack': S.sheet = null; act('tlAction', ['helperRevert', { empId: id }], 'Returned to own line', 'cc-' + id); render(); break;
        case 'ccRing': S.sheet = null; act('tlAction', ['ring', { empId: id, message: RING_REASONS[parseInt(t.getAttribute('data-k'), 10)] || RING_REASONS[0] }], 'Bell rung', 'cc-' + id); render(); break;
        case 'ccAtt':
          var ak = t.getAttribute('data-k'), at2 = $('ccAttTime') ? $('ccAttTime').value : '';
          if ((ak === 'late' || ak === 'early') && !at2) { toast('Enter the time.'); break; }
          S.sheet = null; act('tlAction', ['attendance', { empId: id, kind: ak, time: at2 }], 'Attendance updated', 'cc-' + id); render(); break;
        case 'sendAnn':
          var msg = $('annMessageInput').value.trim();
          if (!msg) { toast('Write a message first.'); break; }
          var me2 = findMe(S.state);
          act('sendAnnouncement', [$('annTargetSelect').value, msg, me2 ? me2.name : '', S.empId], 'Announcement sent');
          $('annMessageInput').value = ''; $('annCounter').textContent = '0 / 240'; break;
        case 'applyAtt':
          var emp = $('attEmpSelect').value, kind = $('attKindSelect').value, time = $('attTimeInput').value;
          if (!emp) { toast('Select a colleague.'); break; }
          if ((kind === 'late' || kind === 'early') && !time) { toast('Enter the time.'); break; }
          var me3 = findMe(S.state);
          act('tlSetAttendance', [emp, kind, time, me3 ? me3.name : ''], 'Attendance updated'); break;
        case 'markAllPresent': act('tlMarkAllPresent', [], function (r) { return r.changed ? r.changed + ' colleague(s) marked present' : 'Everyone is already present'; }); break;
        case 'nsRequest':
          var awb = $('nsAwbInput').value.trim();
          if (!awb) { toast('Enter or scan an AWB first.'); break; }
          $('nsAwbInput').value = '';
          act('pdaRequestNonSortCount', [S.empId, awb], 'AWB sent. Waiting for the TL count...'); break;
        case 'nsSetCount':
          var inp = document.getElementById('nsc-' + id);
          var q = inp ? parseInt(inp.value, 10) : 0;
          if (!(q >= 1)) { toast('Enter a quantity.'); break; }
          act('tlSetNonSortCount', [id, q], 'Count sent', 'nsc-' + id); break;
        case 'nsCancelTl': act('pdaCancelNonSort', [id], 'Request removed', 'nsx-' + id); break;
        case 'nsCancelMine': act('pdaCancelNonSort', [id], 'Request removed', 'nsx-' + id); break;
        case 'nsConfirm': act('pdaCompleteNonSortPutaway', [id], 'Putaway recorded. Leaderboard updated.', 'nsd-' + id); break;
      }
    }
    document.addEventListener('touchstart', unlockAudio, { passive: true });
    $('workerSearchInput').addEventListener('input', renderLoginList);
    $('prodSearch').addEventListener('input', function () { P.q = this.value; renderProd(); });
    $('prodDate').addEventListener('change', function () { if (this.value) { P.date = this.value; loadProd(); } });
    $('pdaPasswordInput').addEventListener('keydown', function (e) { if (e.key === 'Enter') submitPassword(); });
    $('helpFile').addEventListener('change', function () { onHelpFile(this.files && this.files[0]); });
    $('myHelpFile').addEventListener('change', function () { var f = this.files && this.files[0]; this.value = ''; onMyHelpFile(f); });
    $('bcMsg').addEventListener('input', function () { $('bcCounter').textContent = this.value.length + ' / 800'; });
    $('bcFile').addEventListener('change', function () { onBcFile(this.files && this.files[0]); });
    $('bcPeopleSearch').addEventListener('input', function () { bcInit(); S.bc.q = this.value; renderBcCompose(S.state); });
    $('annMessageInput').addEventListener('input', function () { $('annCounter').textContent = this.value.length + ' / 240'; });
    document.addEventListener('visibilitychange', function () { if (!document.hidden) { acquireWake(); pollOnce(); } });

    // ---------- boot ----------
    window.addEventListener('online', function () { S.netFails = 0; updateNet(); flushQueue(); pollOnce(); });
    window.addEventListener('offline', updateNet);
    applyPrefs(); updateNet();
    refreshAlertChip();
    render();
    loadLoginList();
    if (S.token) { acquireWake(); }
    setInterval(tickBreak, 1000);
    pollLoop();
  </script>
</body>
</html>